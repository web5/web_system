/* 个人信息页
 * 色值一律走 app.wxss 的设计 token。 */
.page { min-height: 100vh; background: var(--page-bg); padding: 24rpx 32rpx 40rpx; }
.profile { display: flex; align-items: center; background: var(--card); border-radius: var(--r-card); padding: 30rpx 28rpx; }

/* 头像区：视觉与「我的」页完全同口径（96rpx 正圆，--r-pill；三档圆角风格不改写它） */
.avatar-wrap {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--r-pill);
  overflow: hidden;
  flex-shrink: 0;
}
.avatar-img { width: 96rpx; height: 96rpx; border-radius: var(--r-pill); display: block; }
.avatar-fallback {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--r-pill);
  background: linear-gradient(135deg, var(--brand-400), var(--brand-600));
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 600;
}
/* chooseAvatar 必须是 button：透明铺满头像，只接管点击，不参与视觉 */
.avatar-hit {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  min-width: 0;
  min-height: 0;
  padding: 0;
  margin: 0;
  background: transparent;
  opacity: 0;
  line-height: normal;
}
.avatar-hit::after { border: none; }

/* 昵称/ID 与「我的」页同字号同口径，显式左对齐 */
.info { flex: 1; margin-left: 24rpx; min-width: 0; text-align: left; }
.n-input { font-size: 32rpx; font-weight: 500; color: var(--t1); width: 100%; text-align: left; }
.d { font-size: 24rpx; color: var(--t3); margin-top: 4rpx; }

.list { background: var(--card); border-radius: var(--r-card); overflow: hidden; margin-top: 20rpx; }
.r { display: flex; justify-content: space-between; align-items: center; padding: 28rpx; border-bottom: 1rpx solid var(--line); font-size: 28rpx; color: var(--t1); }
.r:last-child { border-bottom: none; }
.v { color: var(--t3); font-size: 26rpx; }
/* 未绑定：值用品牌深档强调可点（--brand-txt 白底 4.9:1，满足可读） */
.v.bind { color: var(--brand-txt); font-weight: 500; }

/* 手机号行：置灰、不可点、无箭头 */
.phone-row.disabled { color: var(--t3); }
.phone-row.disabled .v { color: var(--t3); }

.foot { font-size: 22rpx; color: var(--t3); text-align: center; margin-top: 20rpx; }
