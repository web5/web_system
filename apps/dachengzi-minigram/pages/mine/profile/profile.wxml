<view class="page {{radiusClass}}">
  <view class="profile">
    <!-- 头像：微信原生 chooseAvatar（必须是 button），无头像时回退「橙」占位 -->
    <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" hover-class="none">
      <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
      <view wx:else class="avatar-fallback">橙</view>
    </button>
    <view class="info">
      <input class="n-input" type="nickname" value="{{nickname}}" placeholder="未设置昵称" bindinput="onNickInput" />
      <view class="d" wx:if="{{uid}}">ID: {{uid}}</view>
    </view>
  </view>

  <button class="save-btn" bindtap="onSave" disabled="{{saving}}" hover-class="none">{{saving ? '保存中…' : '保存'}}</button>

  <view class="list">
    <!-- 手机号：暂不可用，置灰占位（去掉 getPhoneNumber 交互，无 tap、无箭头） -->
    <view class="r phone-row disabled"><text>手机号</text><text class="v">暂不可用</text></view>

    <!-- 邮箱：自绘绑定页（验证码需要输入框，原生弹窗无法承载） -->
    <view class="r email-row" bindtap="onEmailTap"><text>邮箱</text><text class="v {{email ? '' : 'bind'}}">{{email || '未绑定'}} ›</text></view>
  </view>

  <view class="foot">昵称与邮箱用于账号识别，可随时更换</view>
</view>
