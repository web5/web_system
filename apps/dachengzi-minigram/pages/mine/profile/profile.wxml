<view class="page {{radiusClass}}">
  <view class="profile">
    <!-- 头像：视觉层用纯 view 画正圆（与「我的」页同口径），chooseAvatar 按钮透明覆盖只负责接点击。
         button 直接当圆形容器：默认 min-width/min-height 会撑成椭圆，且部分机型 border-radius+overflow 裁剪失效 -->
    <view class="avatar-wrap">
      <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
      <view wx:else class="avatar-fallback">橙</view>
      <button class="avatar-hit" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" hover-class="none" aria-label="更换头像"></button>
    </view>
    <view class="info">
      <input class="n-input" type="nickname" value="{{nickname}}" placeholder="未设置昵称" bindinput="onNickInput" bindblur="onNickBlur" bindconfirm="onNickConfirm" />
      <view class="d" wx:if="{{uid}}">ID: {{uid}}</view>
    </view>
  </view>

  <view class="list">
    <!-- 手机号：暂不可用，置灰占位（去掉 getPhoneNumber 交互，无 tap、无箭头） -->
    <view class="r phone-row disabled"><text>手机号</text><text class="v">暂不可用</text></view>

    <!-- 邮箱：自绘绑定页（验证码需要输入框，原生弹窗无法承载） -->
    <view class="r email-row" bindtap="onEmailTap"><text>邮箱</text><text class="v {{email ? '' : 'bind'}}">{{email || '未绑定'}} ›</text></view>
  </view>

  <view class="foot">昵称与邮箱用于账号识别，可随时更换</view>
</view>
