/* 关于与免责
 * 浅色蓝底白卡。色值一律取 app.wxss 的设计 token：
 *   --page-bg 页底 / --card 卡片 / --t1 主文字 / --t2 次文字 / --t3 辅助文字 / --brand-600 主蓝。
 * 卡片描边是品牌蓝 #2563EB 的 10% 透明（token 层无对应项，此处是全文件唯一字面色值）。 */
.page { min-height: 100vh; background: var(--page-bg); padding: 40rpx 32rpx; box-sizing: border-box; }

.brand { display: flex; flex-direction: column; align-items: center; padding: 16rpx 0 40rpx; }
.logo {
  width: 120rpx;
  height: 120rpx;
  /* 圆形：走 --r-pill(999rpx)，三档圆角风格下都不改写它，仍是正圆；
     不写字面 50%，避免新增页出现裸圆角值（app.wxss 要求新增页一律取 token） */
  border-radius: var(--r-pill);
  background: var(--brand-600);
  color: var(--on-brand);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  font-weight: 600;
}
.name { margin-top: 20rpx; font-size: 32rpx; font-weight: 600; color: var(--t1); }
.ver { margin-top: 8rpx; font-size: 24rpx; color: var(--t3); }

.card {
  background: var(--card);
  border: 1rpx solid rgba(37, 99, 235, .10);
  border-radius: var(--r-card);
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.card-t { font-size: 26rpx; font-weight: 600; color: var(--t1); margin-bottom: 14rpx; }
.p { font-size: 25rpx; color: var(--t2); line-height: 1.8; margin-bottom: 10rpx; }
.p:last-child { margin-bottom: 0; }

.list {
  background: var(--card);
  border: 1rpx solid rgba(37, 99, 235, .10);
  border-radius: var(--r-card);
  overflow: hidden;
  margin-bottom: 24rpx;
}
.r { display: flex; justify-content: space-between; align-items: center; padding: 28rpx; font-size: 28rpx; color: var(--t1); }
.r:active { background: rgba(60, 60, 67, .03); }
.v { color: var(--t3); font-size: 26rpx; }

.foot { font-size: 22rpx; color: var(--t3); text-align: center; margin-top: 20rpx; }
