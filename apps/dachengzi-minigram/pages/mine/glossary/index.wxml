<!-- 收藏：句子快照卡片（英文 + 出处 + 译文 + meta），点 × 删除 -->
<view class="page {{radiusClass}}">
  <view class="tip">你收藏的句子会一直保留在这里。</view>
  <view class="loading" wx:if="{{loading}}">载入中…</view>

  <block wx:if="{{!loading && !empty}}">
    <view class="gi" wx:for="{{items}}" wx:key="id">
      <view class="en">{{item.enMain}}</view>
      <view class="src" wx:if="{{item.sourceText}}">{{item.sourceText}}</view>
      <view class="note" wx:if="{{item.note}}">{{item.note}}</view>
      <view class="meta" wx:if="{{item.metaText}}">{{item.metaText}}</view>
      <view class="x" data-id="{{item.id}}" bindtap="onRemove" aria-label="删除">
        <view class="x1"></view>
        <view class="x2"></view>
      </view>
    </view>
    <view class="foot">点右上角 × 删除收藏</view>
  </block>

  <view class="empty" wx:if="{{!loading && empty}}">
    <view class="ico"><view class="ico-note"></view></view>
    <view class="e1">还没有收藏</view>
    <view class="e2">在课文中点句子旁的「收藏」</view>
    <view class="go" bindtap="goNce">去学课文</view>
  </view>
</view>
