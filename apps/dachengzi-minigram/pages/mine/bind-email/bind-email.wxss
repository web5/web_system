/* 绑定邮箱：自绘表单页（原生弹窗无输入框） */
/* app.wxss 无全局 .page，本页须自带左右留白，否则 label/输入框/按钮贴边 */
.page { min-height: 100vh; background: var(--page-bg); padding: 24rpx 32rpx 40rpx; box-sizing: border-box; }

.doc {
  background: var(--card);
  border-radius: var(--r-card);
  padding: 28rpx;
  font-size: 25rpx;
  color: var(--t2);
  line-height: 1.75;
}
.doc .b { color: var(--t1); font-weight: 500; }

.sec-t { font-size: 24rpx; color: var(--t2); margin: 32rpx 0 16rpx; }
.list { background: var(--card); border-radius: var(--r-card); overflow: hidden; }
.row { display: flex; align-items: center; padding: 20rpx 28rpx; }

.ipt { flex: 1; min-width: 0; font-size: 28rpx; color: var(--t1); }
.sbtn { flex: none; font-size: 25rpx; color: var(--brand-txt); font-weight: 500; padding-left: 20rpx; }
.sbtn.off { color: var(--t3); }

.err { min-height: 32rpx; margin: 12rpx 8rpx 0; font-size: 23rpx; color: var(--red); }

.btn {
  margin-top: 48rpx;
  height: 88rpx;
  border-radius: var(--r-pill);
  background: var(--brand);
  color: var(--on-brand);
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}
.btn.off { opacity: .6; }

.foot { font-size: 22rpx; color: var(--t3); text-align: center; margin-top: 24rpx; line-height: 1.7; }
