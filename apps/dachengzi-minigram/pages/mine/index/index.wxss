/* ===== 大橙子个人助理 - 我的（tab 3） ===== */
page {
  background: var(--page-bg);
}

.page {
  min-height: 100vh;
  background: var(--page-bg);
  /* 自定义 tabBar 不占原生层，页面需自行留出底部空间 */
  padding: 24rpx 32rpx calc(150rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  /* 登录引导卡是 absolute 铺满，父级需定位上下文 */
  position: relative;
}

/* 未登录：锁滚动，登录墙不会被滚出视野（否则能滚出内容与退出入口） */
.page.locked {
  height: 100vh;
  overflow: hidden;
}

.profile {
  display: flex;
  align-items: center;
  background: var(--card);
  border-radius: var(--r-card);
  padding: 30rpx 28rpx;
}
.profile:active { opacity: .8; }
.avatar {
  width: 96rpx;
  height: 96rpx;
  /* 圆形走 --r-pill(999rpx)：三档圆角风格都不改写它，仍是正圆 */
  border-radius: var(--r-pill);
  background: linear-gradient(135deg, var(--brand-400), var(--brand-600));
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 600;
}
.info { flex: 1; margin-left: 24rpx; min-width: 0; }
.n { font-size: 32rpx; font-weight: 500; color: var(--t1); }
.d { font-size: 24rpx; color: var(--t3); margin-top: 4rpx; }
.arw { color: var(--t3); font-size: 30rpx; }

/* 三组列表上下相邻，组间距 20rpx（不再有分组标题行） */
.list {
  background: var(--card);
  border-radius: var(--r-card);
  overflow: hidden;
  margin-top: 20rpx;
}
.r {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx;
  border-bottom: 1rpx solid var(--line);
  font-size: 28rpx;
  color: var(--t1);
}
.r:last-child { border-bottom: none; }
.r:active { background: rgba(60, 60, 67, .03); }
.v { color: var(--t3); font-size: 26rpx; }

.foot {
  margin-top: 40rpx;
  font-size: 21rpx;
  color: var(--t3);
  text-align: center;
  line-height: 1.9;
}
