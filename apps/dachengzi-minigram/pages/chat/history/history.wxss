/* ===== 大橙子个人助理 · 对话记录列表页 =====
 * 蓝色系 token（app.wxss --brand-*），页面底色 #F5F8FF（--page-bg）。 */

page {
  background: var(--page-bg);
}

.page {
  min-height: 100vh;
  background: var(--page-bg);
  padding: 24rpx 32rpx 48rpx;
  box-sizing: border-box;
}

/* ---------- 头部 ---------- */
.hd {
  display: flex;
  align-items: center;
  height: 80rpx;
  margin-bottom: 12rpx;
}
.hd-l {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.back-chev {
  width: 18rpx;
  height: 18rpx;
  border-left: 4rpx solid var(--t1);
  border-bottom: 4rpx solid var(--t1);
  transform: rotate(45deg);
  margin-left: 6rpx;
}
.hd-t {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--t1);
}
.hd-r {
  flex: none;
  padding: 8rpx 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--brand-txt);
}
.hd-hover { opacity: .6; }

/* ---------- 加载中 ---------- */
.loading {
  padding: 120rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--t3);
}

/* ---------- 列表 ---------- */
.list {
  background: var(--card);
  border: 1rpx solid rgba(37, 99, 235, .10);
  border-radius: var(--r-card);
  overflow: hidden;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, .06);
}
.r {
  display: flex;
  align-items: center;
  padding: 28rpx 28rpx;
  border-bottom: 1rpx solid rgba(37, 99, 235, .08);
}
.r:last-child { border-bottom: none; }
.r:active { background: var(--brand-50); }
.rl { flex: 1; min-width: 0; }
.r-title {
  display: block;
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--t1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.r-sub { display: block; margin-top: 8rpx; font-size: 22rpx; color: var(--t3); }
.r-arrow { flex: none; margin-left: 16rpx; font-size: 32rpx; color: var(--t3); }

.foot { margin-top: 22rpx; font-size: 21rpx; color: #98A0AE; text-align: center; }

/* ---------- 空态 ---------- */
.empty { padding: 120rpx 0 0; display: flex; flex-direction: column; align-items: center; }
.ill { position: relative; width: 240rpx; height: 168rpx; margin-bottom: 36rpx; }
.ill-bubble {
  position: absolute;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: var(--r-card);
}
.ill-b1 {
  left: 0; top: 8rpx; width: 104rpx; height: 74rpx;
  background: var(--brand-50); color: var(--brand-txt);
  border-radius: var(--r-card) var(--r-card) var(--r-chip) var(--r-card);
}
.ill-b2 {
  right: 0; bottom: 12rpx; width: 96rpx; height: 70rpx;
  background: var(--card); color: var(--t3);
  border: 1rpx solid rgba(37, 99, 235, .14);
  border-radius: var(--r-card) var(--r-card) var(--r-card) var(--r-chip);
}
.ill-line { position: absolute; left: 104rpx; top: 96rpx; width: 56rpx; height: 2rpx; background: rgba(37, 99, 235, .18); transform: rotate(-18deg); }

.et { font-size: 30rpx; font-weight: 600; color: var(--t1); }
.es { margin-top: 12rpx; font-size: 24rpx; color: var(--t3); }
.ebtn {
  margin-top: 40rpx;
  min-width: 280rpx;
  height: 84rpx;
  padding: 0 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--brand-600);
  color: var(--on-brand);
  font-size: 28rpx;
  border-radius: var(--r-pill);
  box-shadow: 0 6rpx 18rpx rgba(37, 99, 235, .22);
}
.ebtn:active { opacity: .88; }
