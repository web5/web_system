<!-- 大橙子个人助理 · 对话记录列表页 -->
<view class="page {{radiusClass}}">
  <view class="hd">
    <view class="hd-l" hover-class="hd-hover" bindtap="goBack"><view class="back-chev"></view></view>
    <text class="hd-t">对话记录</text>
    <view class="hd-r" hover-class="hd-hover" bindtap="newChat">新对话</view>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading">加载中…</view>

  <block wx:elif="{{list.length > 0}}">
    <!-- 有数据 -->
    <view class="list">
      <view class="r" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="open">
        <view class="rl">
          <text class="r-title">{{item.title}}</text>
          <text class="r-sub">{{item.time}}</text>
        </view>
        <text class="r-arrow">›</text>
      </view>
    </view>
    <view class="foot">对话记录跟随账号，换设备也能接着聊</view>
  </block>

  <view class="empty" wx:else>
    <!-- 空态 -->
    <view class="ill">
      <view class="ill-bubble ill-b1">A</view>
      <view class="ill-bubble ill-b2">文</view>
      <view class="ill-line"></view>
    </view>
    <view class="et">还没有对话记录</view>
    <view class="es">发起一次对话就会出现在这里</view>
    <view class="ebtn" bindtap="newChat">发起新对话</view>
  </view>
</view>
