/* ===== 大橙子个人助理 · 主对话页（气泡对话） =====
 * 浅色白底蓝色品牌系（同源 prototype 12-气泡对话原型稿）。取色一律走 app.wxss token。
 * 气泡形态：用户右实心蓝 #2563EB（--brand-600），AI 左白底。 */

page {
  background: var(--page-bg);
  height: 100%;
}

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--page-bg);
  box-sizing: border-box;
  overflow: hidden;
}

/* ---------- 自绘导航 ---------- */
.navbar {
  flex: none;
  background: var(--page-bg);
  border-bottom: 1rpx solid var(--line);
  box-sizing: border-box;
}
.navbar-inner {
  position: relative;
  display: flex;
  align-items: center;
  padding-left: 12rpx;
  box-sizing: border-box;
}
.nav-hover { opacity: .6; }

.nav-back {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.back-chev {
  width: 18rpx;
  height: 18rpx;
  border-left: 4rpx solid var(--t1);
  border-bottom: 4rpx solid var(--t1);
  transform: rotate(45deg);
  margin-left: 6rpx;
}

.nav-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--t1);
  white-space: nowrap;
}
.nav-badge {
  font-size: 18rpx;
  font-weight: 500;
  color: var(--brand-txt);
  background: var(--brand-50);
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
}

.nav-hist {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: auto;
}
.hist-bars { display: flex; flex-direction: column; gap: 6rpx; }
.hist-bars i { width: 30rpx; height: 3rpx; border-radius: 2rpx; background: var(--icon); }

.nav-act {
  flex: none;
  margin-left: 4rpx;
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--brand-txt);
}

/* ---------- 消息流 ---------- */
.msgs {
  flex: 1;
  min-height: 0;
  padding: 20rpx 24rpx 0;
  box-sizing: border-box;
}
.chat-bottom { height: 20rpx; }

/* 空态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
}
.greet { font-size: 28rpx; color: var(--t3); line-height: 1.8; letter-spacing: .6rpx; }
.sugs { margin-top: 44rpx; width: 100%; display: flex; flex-direction: column; gap: 20rpx; }
.sug {
  padding: 22rpx 26rpx;
  background: var(--card);
  border: 1rpx solid rgba(37, 99, 235, .10);
  border-radius: var(--r-control);
  font-size: 26rpx;
  color: var(--t2);
  text-align: left;
}
.sug-hover { background: var(--brand-50); }

/* 消息行 */
.msg { display: flex; gap: 14rpx; margin-bottom: 26rpx; align-items: flex-start; }
.msg.user { flex-direction: row-reverse; }
.av {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  margin-top: 2rpx;
}
.msg.ai .av { background: linear-gradient(140deg, var(--brand-500), var(--brand-700)); color: #fff; }
.msg.user .av { background: #E5E8EF; color: var(--t2); }

.bd { max-width: 78%; min-width: 0; }
.msg.user .bd { display: flex; flex-direction: column; align-items: flex-end; }

.bub {
  background: var(--card);
  border: 1rpx solid rgba(37, 99, 235, .10);
  border-radius: 8rpx 28rpx 28rpx 28rpx;
  padding: 18rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.62;
  color: var(--t1);
  word-break: break-word;
  white-space: pre-wrap;
  box-shadow: 0 2rpx 8rpx rgba(20, 30, 60, .05);
}
.msg.user .bub {
  background: var(--brand-600);
  border-color: var(--brand-600);
  color: #fff;
  border-radius: 28rpx 8rpx 28rpx 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(37, 99, 235, .22);
}

/* 流式光标 */
.caret {
  display: inline-block;
  width: 4rpx;
  height: 28rpx;
  background: var(--brand-600);
  margin-left: 4rpx;
  vertical-align: -4rpx;
  animation: blink 1s steps(1) infinite;
}
@keyframes blink { 0%, 100% { opacity: .28; } 50% { opacity: 1; } }

/* 流式等待三点 */
.typing-bubble { display: flex; align-items: center; }
.tdots { display: flex; gap: 6rpx; }
.tdot { width: 10rpx; height: 10rpx; border-radius: 50%; background: var(--brand-600); animation: blinkdot 1.2s infinite; }
.tdot:nth-child(2) { animation-delay: .2s; }
.tdot:nth-child(3) { animation-delay: .4s; }
@keyframes blinkdot { 0%, 100% { opacity: .25; } 50% { opacity: 1; } }

/* 失败态 */
.bub.err { border-color: var(--red-soft); }
.bub.err .bub-text { color: var(--red); }
.retry {
  margin-top: 10rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--brand-txt);
  padding: 4rpx 8rpx;
}

/* ---------- 翻译卡气泡 ---------- */
.tr-bubble { padding: 0; overflow: hidden; }
.tr-head { display: flex; align-items: center; gap: 12rpx; padding: 18rpx 24rpx 0; }
.tr-tag { font-size: 18rpx; color: #fff; background: var(--brand-600); border-radius: 8rpx; padding: 2rpx 12rpx; font-weight: 500; }
.tr-meta { font-size: 20rpx; color: var(--t3); }
.tr-main {
  padding: 16rpx 24rpx 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.55;
  color: var(--t1);
  white-space: pre-wrap;
  word-break: break-word;
}
.tr-note {
  padding: 16rpx 24rpx;
  border-top: 1rpx solid var(--line);
  font-size: 22rpx;
  color: var(--t2);
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-word;
}

/* ---------- 输入栏 ---------- */
.input-bar {
  flex: none;
  padding: 12rpx 24rpx 0;
  background: var(--page-bg);
}
.composer {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: var(--card);
  border: 1rpx solid rgba(60, 60, 67, .10);
  border-radius: 999rpx;
  padding: 8rpx 8rpx 8rpx 28rpx;
  box-shadow: 0 6rpx 24rpx rgba(31, 36, 46, .05);
}
.composer-input {
  flex: 1;
  min-width: 0;
  height: 56rpx;
  font-size: 28rpx;
  color: var(--t1);
}
.composer-ph { color: var(--t3); font-size: 26rpx; }
.send-btn {
  flex: none;
  height: 64rpx;
  min-width: 112rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: var(--brand-100);
  color: var(--brand-txt);
  font-size: 26rpx;
  font-weight: 600;
}
.send-on { background: var(--brand-600); color: var(--on-brand); box-shadow: 0 4rpx 14rpx rgba(37, 99, 235, .30); }
.send-dis { opacity: .5; }
.safe-bottom { height: calc(24rpx + env(safe-area-inset-bottom)); }
