<!-- 大橙子英语 · 发现（tab 2）：全部功能列表 + 每项「添加常用」开关 -->
<view class="page {{radiusClass}} {{loggedIn ? '' : 'locked'}}">
  <!-- 未登录：只渲染登录引导卡，不发起任何业务请求 -->
  <login-gate wx:if="{{!loggedIn}}" desc="发现页的能力与记录都关联你的账号" agreement-url="/pages/mine/agreement/agreement" bind:logged="onLogged" />

  <block wx:if="{{loggedIn}}">
    <view class="sec-t">全部功能</view>

    <view class="cap" wx:for="{{features}}" wx:key="id" data-path="{{item.path}}" bindtap="openFeature">
      <view class="ic {{item.iconClass}}">{{item.icon}}</view>
      <view class="tx">
        <view class="b">{{item.title}}</view>
        <view class="e">{{item.desc}}</view>
      </view>
      <view class="toggle {{item.pinned ? 'on' : ''}}" data-id="{{item.id}}" catchtap="toggleFeature">
        {{item.pinned ? '已添加' : '+ 添加'}}
      </view>
    </view>

    <view class="foot">更多内容持续更新中</view>
  </block>
</view>
