<!-- 科豆 AI · 发现（tab 2）：能力市场 —— 只放翻译与新概念英语两个能力 -->
<view class="page {{radiusClass}} {{loggedIn ? '' : 'locked'}}">
  <!-- 未登录：只渲染登录引导卡（Q1 必须登录才可用），不发起任何业务请求 -->
  <login-gate wx:if="{{!loggedIn}}" desc="发现页的能力与记录都关联你的账号" agreement-url="/pages/mine/agreement/agreement" bind:logged="onLogged" />

  <block wx:if="{{loggedIn}}">
  <view class="sec-t">AI 能力<text class="em">点开即用</text></view>

  <view class="cap" bindtap="openTranslate">
    <view class="ic t">译</view>
    <view class="tx">
      <view class="b">语言翻译官</view>
      <view class="e">中英日德互译 · 语气风格可选 · 译完可追问</view>
    </view>
    <text class="go">›</text>
  </view>

  <!-- 新概念英语：NCE2 逐句精读，入口与 PC portal「发现」对齐 -->
  <view class="cap" bindtap="openNce">
    <view class="ic n">英</view>
    <view class="tx">
      <view class="b">新概念英语</view>
      <view class="e">NCE2 逐句精读 · 点句出译文 · 生词就地查</view>
    </view>
    <text class="go">›</text>
  </view>

  <view class="foot">两个能力，点开即用</view>
  <view class="claim">内容由 AI 生成，仅供参考，不构成法律意见
已依法完成大模型与算法备案</view>
  </block>
</view>
