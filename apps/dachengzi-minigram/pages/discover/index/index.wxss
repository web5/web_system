/* ===== 科豆 AI - 发现页（tab 2） ===== */
page {
  background: var(--page-bg);
}

.page {
  min-height: 100vh;
  background: var(--page-bg);
  /* 自定义 tabBar 不占原生层，页面需自行留出底部空间，否则内容被它盖住 */
  padding: 24rpx 32rpx calc(150rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  /* 登录引导卡是 absolute 铺满，父级需定位上下文 */
  position: relative;
}

/* 未登录：锁滚动，登录墙不会被滚出视野 */
.page.locked {
  height: 100vh;
  overflow: hidden;
}

.sec-t {
  font-size: 25rpx;
  color: var(--t2);
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin: 8rpx 4rpx 16rpx;
}
.sec-t .em { font-size: 22rpx; color: var(--t3); }

/* 能力卡 */
.cap {
  display: flex;
  align-items: center;
  background: var(--card);
  border-radius: var(--r-card);
  padding: 28rpx 26rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(20, 30, 60, .04);
}
.cap:active { opacity: .75; }

.ic {
  flex: 0 0 76rpx;
  width: 76rpx;
  height: 76rpx;
  border-radius: var(--r-card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  background: var(--brand-soft);
  color: var(--brand-txt);
  margin-right: 22rpx;
}
.ic.t { background: var(--brand-soft); color: var(--brand-txt); }
/* 新概念英语：青色点缀，与阅读页 #0EA5A4 呼应 */
.ic.n { background: rgba(14, 165, 164, .10); color: #0EA5A4; }
/* 对话练习：品牌色（与翻译卡同族） */
.ic.c { background: var(--brand-soft); color: var(--brand-txt); }

/* 功能设置入口卡：暗门解锁后常驻（第一节标题之上，随页面滚动，不吸顶） */
.labs {
  display: flex;
  align-items: center;
  background: var(--card);
  border: 1rpx dashed var(--brand-100);
  border-radius: var(--r-card);
  padding: 28rpx 26rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(20, 30, 60, .04);
}
.labs:active { opacity: .75; }
.ic.s { background: var(--brand-soft); color: var(--brand-txt); font-size: 30rpx; }

/* 解锁反馈：入口卡 200ms 淡入 */
.fade-in { animation: labs-fade-in .2s ease-out; }
@keyframes labs-fade-in {
  from { opacity: 0; transform: translateY(-8rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.tx { flex: 1; min-width: 0; }
.tx .b {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--t1);
}
.tx .e {
  font-size: 23rpx;
  color: var(--t3);
  margin-top: 6rpx;
}

.go { font-size: 34rpx; color: var(--t3); margin-left: 12rpx; }

.foot {
  margin-top: 48rpx;
  font-size: 22rpx;
  color: var(--t3);
  text-align: center;
  line-height: 1.8;
}
