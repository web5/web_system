<!-- 大橙子个人助理 · 首页（tab 1 / 启动页）
     结构固定：问候 hero → 两条能力入口（翻译 / 新概念英语）→ 最近使用 → 提示 → 合规两行。
     ⚠️ 只放两条能力入口，不要加第三条 —— 新能力先进「发现」，首页只留最常用的两个。 -->
<view class="page {{radiusClass}}">
  <!-- 问候 hero -->
  <view class="hero">
    <view class="logo">橙</view>
    <view class="hero-tx">
      <view class="hi">下午好</view>
      <view class="hi-sub">今天想处理点什么？</view>
    </view>
  </view>

  <!-- 新对话：hero 区快捷入口（独立于两条能力入口，不新增第三条能力） -->
  <view class="newchat" hover-class="newchat-hover" bindtap="goChat">
    <view class="n-ic">＋</view>
    <view class="n-tx">
      <view class="n-b">新对话</view>
      <view class="n-e">直接和 AI 聊天 · 随时追问</view>
    </view>
    <text class="n-go">›</text>
  </view>

  <!-- 能力入口 1：翻译 -->
  <view class="cap" hover-class="cap-hover" bindtap="goTranslate">
    <view class="ic">译</view>
    <view class="tx">
      <view class="b">翻译</view>
      <view class="e">中英互译 · 译完可以继续追问</view>
    </view>
    <text class="go">›</text>
  </view>

  <!-- 能力入口 2：新概念英语 -->
  <view class="cap" hover-class="cap-hover" bindtap="goNce">
    <view class="ic">英</view>
    <view class="tx">
      <view class="b">新概念英语</view>
      <view class="e">逐句精读 · 生词与跟读练习</view>
    </view>
    <text class="go">›</text>
  </view>

  <!-- 最近使用（空态；有记录的态待「最近使用」数据接入后渲染） -->
  <view class="sec-t">最近使用<text class="em">暂无记录</text></view>
  <view class="empty">还没有记录。翻译一次或学一课后会出现在这里；登录后换设备也能接着看。</view>

  <view class="hint">两个能力，进来就能用完 —— 不需要先学会怎么用。</view>

  <view class="claim-foot">
    <view class="claim">内容由 AI 生成，仅供参考，不构成法律意见
已依法完成大模型与算法备案</view>
  </view>
</view>
