<!-- 大橙子英语 · 首页（tab 1 / 启动页）
     整改后：问候 hero → 今日一句 → 常用功能（默认 NCE）→ 更多功能跳发现。 -->
<view class="page {{radiusClass}} {{loggedIn ? '' : 'locked'}}">
  <!-- 未登录：整页只渲染登录引导卡（login-gate），不发任何业务请求 -->
  <login-gate wx:if="{{!loggedIn}}" desc="学习进度和收藏都跟着账号走" agreement-url="/pages/mine/agreement/agreement" bind:logged="onLogged" />

  <block wx:if="{{loggedIn}}">
    <!-- 问候 hero -->
    <view class="hero">
      <view class="logo">橙</view>
      <view class="hero-tx">
        <view class="hi">{{greetingText}}</view>
        <view class="hi-sub">今天想学哪一课？</view>
      </view>
    </view>

    <!-- 今日一句：本地文案池按日期取模，同天稳定、隔天自动换
         册别角标（A3 方案① / 原型 d3c3730281e758d8）：标题行右侧浅青 pill；
         book 缺失时 bookBadge 为空串 → wx:if 隐藏，不显 undefined
         2026-11-26 ⑤：点整句朗读（bindtap），生词可点开词卡；词卡内可朗读/收藏单词
         2026-11-26 step2：长按英文单词 / 英文句子空白 → 底部动作抽屉（components/action-drawer） -->
    <view class="daily" bindtap="speakQuote">
      <view class="daily-top">
        <view class="daily-k">今日一句</view>
        <view class="badge-pill" wx:if="{{showBookBadge && bookBadge}}">{{bookBadge}}</view>
      </view>
      <view class="daily-cn">{{quote.cn}}</view>
      <!-- 🔴 长按只挂英文句子容器（catchlongpress），**不许挂整张 .daily 卡**：
           挂卡片上会让中文行与「朗读 / 收藏」按钮的长按也弹出句子抽屉（越界触发）。
           点按：卡片 bindtap 读整句；单词节点 catchtap 会吞掉冒泡 → 普通词由 `onQuoteWordTap`
           首行守卫 return（E1 点按普通词无反应），生词出词卡。 -->
      <view class="daily-en" catchlongpress="onQuoteLineLongPress">
        <!-- 渲染结构改造（方案 K12）：**所有**英文 token 都渲染成 <text class="dw"> 节点，
             不再「生词有节点 / 表外词是裸文本」—— 否则普通词没有载体，长按无从挂起。
             `has-def` 点线只给课文词表直收词（生词），普通词是纯文本外观但可长按。
             标点 token（tk.w 为空）仍走 wx:else 纯文本，不参与点按/长按。
             🔴 wx:for-item="tk" 必须保留：漏写时迭代变量恒为 item，循环体内 tk.* 全部求值
                undefined → 整段英文渲染为空（P0 缺陷，见 tests/wxml-for-item-scope.test.ts）。 -->
        <block wx:for="{{quoteTokens}}" wx:key="idx" wx:for-item="tk">
          <!-- E4 后半（盲测 D-4）·长按瞬间按下高亮 = 反馈，不是暗示：
               · `<text>` **不支持** hover-class（微信仅 view / button / navigator 支持，
                 官方文档 text 属性表里没有该项），故不能只靠 hover-class；
               · 裸 `.dw:active` 又被「点非生词不得有词级高亮」的既有守卫禁止；
               · 故用「长按态 class」：touchstart 记下当前词 key、touchend/cancel 清空，
                 wxml 按 key 插值出 dw-pressed（浅蓝底），松手 / 出抽屉即消失。 -->
          <text
            wx:if="{{tk.w}}"
            class="dw {{tk.hasDef ? 'has-def' : ''}} {{pressedWordKey === tk.idx ? 'dw-pressed' : ''}}"
            data-w="{{tk.w}}"
            data-hasdef="{{tk.hasDef}}"
            data-k="{{tk.idx}}"
            catchtap="onQuoteWordTap"
            catchlongpress="onQuoteWordLongPress"
            bindtouchstart="onWordPressStart"
            bindtouchend="onWordPressEnd"
            bindtouchcancel="onWordPressEnd"
            hover-class="dw-pressed"
            hover-start-time="0"
            hover-stay-time="600"
          >{{tk.t}}</text>
          <text wx:else>{{tk.t}}</text>
        </block>
      </view>
      <!-- 🔴 停止朗读入口**只有这一处**（2026-11-26 去重）：
           U1 的初衷是补详情页「关掉抽屉后没有任何停止入口」这个空洞；首页页脚本来就有
           「▶ 朗读 / ■ 停止」+「☆ 收藏」一组动作按钮，再叠一个行尾 ■ 会让用户看到两个 ■。
           故**首页不重复实现 U1**（行尾 ■ 已删），停止入口统一在页脚 .dq-act。
           详情页 pages/nce/detail/ 的 U1 保留不动——那边没有别的停止入口。 -->
      <view class="daily-foot">
        <view class="dq-act {{quotePlaying ? 'on' : ''}}" catchtap="speakQuote">{{quotePlaying ? '■ 停止' : '▶ 朗读'}}</view>
        <view class="dq-act" catchtap="collectQuote">☆ 收藏</view>
      </view>
    </view>

    <!-- 今日一句词卡：底部浮层（跟课文详情页同一形态，独立 .q-tip 前缀避免跨页样式耦合）
         单槽位：只在 overlay.kind === 'wordtip' 时渲染，与抽屉互斥（同一个 overlay 字段） -->
    <view wx:if="{{overlay && overlay.kind === 'wordtip'}}" class="q-tip">
      <view class="q-tip-head">
        <view class="q-tip-w">{{overlay.word}}</view>
        <view class="q-tip-tools">
          <!-- 🔴 AC-3.1 / AC-3.3 / AC-3.4（2026-11-26 盲测 D-1 修）：词卡朗读按钮是圆形播放图标，
               不是文字「朗读 / 停止」。形态照原型 `.btn-icon`：未播 ▶ 三角、播放中 ■ 方块，CSS 画。
               热区 88rpx ⊃ 视觉圆 60rpx ⊃ 图标 ≈32rpx；aria-label 随形态切换
               （文案真源 utils/line-actions 的 ARIA_WORD_PLAY / ARIA_WORD_STOP）。 -->
          <view class="q-tip-btn q-tip-play {{quoteWordPlaying ? 'on' : ''}}" catchtap="speakQuoteWord"
                hover-class="q-tip-play-hv" aria-role="button"
                aria-label="{{quoteWordPlaying ? ariaStopWord : ariaPlayWord}}">
            <view class="q-tip-ico"></view>
          </view>
          <view class="q-tip-btn" catchtap="collectQuoteWord">收藏</view>
          <view class="q-tip-x" catchtap="closeQuoteTip">✕</view>
        </view>
      </view>
      <view wx:if="{{overlay.phonetic}}" class="q-tip-p">{{overlay.phonetic}}</view>
      <view wx:if="{{overlay.pos}}" class="q-tip-pos">{{overlay.pos}}</view>
      <view wx:if="{{overlay.none}}" class="q-tip-none">暂无释义（课文词汇表未收录该词）</view>
      <view wx:elif="{{overlay.def}}" class="q-tip-def">{{overlay.def}}</view>
      <view wx:if="{{overlay.example}}" class="q-tip-ex">{{overlay.example}}</view>
    </view>

    <!-- 长按动作抽屉（变体 B）：**复用** components/action-drawer，本页不画任何抽屉结构。
         7 个属性 + 5 个事件与方案 §3.1/§3.2 契约逐字对齐；hidden 由 overlay 单槽位驱动。
         🔴 不要在页面里出现第二份 .ad-* 结构 / 第二份 ACTIONS 表：
            动作顺序（朗读此句 → 收藏此句 → 朗读单词 → 收藏单词）只有 utils/line-actions 一份真源。 -->
    <action-drawer
      visible="{{overlay && overlay.kind === 'drawer'}}"
      scope="{{overlay && overlay.kind === 'drawer' ? overlay.scope : ''}}"
      line-text="{{overlay && overlay.kind === 'drawer' ? overlay.lineText : ''}}"
      line-index="{{overlay && overlay.kind === 'drawer' ? overlay.lineIndex : -1}}"
      word="{{overlay && overlay.kind === 'drawer' ? overlay.word : ''}}"
      word-has-def="{{overlay && overlay.kind === 'drawer' ? overlay.hasDef : false}}"
      phonetic="{{overlay && overlay.kind === 'drawer' ? overlay.phonetic : ''}}"
      bind:speak-line="onDrawerSpeakLine"
      bind:speak-word="onDrawerSpeakWord"
      bind:collect-line="onDrawerCollectLine"
      bind:collect-word="onDrawerCollectWord"
      bind:close="onDrawerClose"
    />

    <!-- 常用功能：注册表 pinned 项（默认 NCE 常驻；收藏可在发现页「添加常用」） -->
    <view class="sec-t">常用功能</view>
    <view class="fcard" wx:for="{{features}}" wx:key="id" data-path="{{item.path}}" bindtap="goFeature">
      <view class="fc-ic ic-{{item.iconClass}}">{{item.icon}}</view>
      <view class="fc-tx">
        <view class="fc-b">{{item.title}}</view>
        <view class="fc-e">{{item.desc}}</view>
      </view>
      <text class="fc-go">›</text>
    </view>
    <view class="more" bindtap="goMore">更多功能 ›</view>

    <view class="hint">每天一句，稳步进阶。</view>
  </block>
</view>
