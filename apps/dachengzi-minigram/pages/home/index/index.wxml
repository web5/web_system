<!-- 大橙子英语 · 首页（tab 1 / 启动页）
     整改后：问候 hero → 今日一句 → 常用功能（默认 NCE）→ 更多功能跳发现。 -->
<view class="page {{radiusClass}} {{loggedIn ? '' : 'locked'}}">
  <!-- 未登录：整页只渲染登录引导卡（login-gate），不发任何业务请求 -->
  <login-gate wx:if="{{!loggedIn}}" desc="学习进度和收藏都跟着账号走" agreement-url="/pages/mine/agreement/agreement" bind:logged="onLogged" />

  <block wx:if="{{loggedIn}}">
    <!-- 问候 hero -->
    <view class="hero">
      <view class="logo">橙</view>
      <view class="hero-tx">
        <view class="hi">下午好</view>
        <view class="hi-sub">今天想学哪一课？</view>
      </view>
    </view>

    <!-- 今日一句：本地文案池按日期取模，同天稳定、隔天自动换 -->
    <view class="daily">
      <view class="daily-k">今日一句</view>
      <view class="daily-cn">{{quote.cn}}</view>
      <view class="daily-en">{{quote.en}}</view>
    </view>

    <!-- 常用功能：注册表 pinned 项（默认 NCE 常驻；收藏可在发现页「添加常用」） -->
    <view class="sec-t">常用功能</view>
    <view class="fcard" wx:for="{{features}}" wx:key="id" data-path="{{item.path}}" bindtap="goFeature">
      <view class="fc-ic ic-{{item.iconClass}}">{{item.icon}}</view>
      <view class="fc-tx">
        <view class="fc-b">{{item.title}}</view>
        <view class="fc-e">{{item.desc}}</view>
      </view>
      <text class="fc-go">›</text>
    </view>
    <view class="more" bindtap="goMore">更多功能 ›</view>

    <view class="hint">每天一句，稳步进阶。</view>
  </block>
</view>
