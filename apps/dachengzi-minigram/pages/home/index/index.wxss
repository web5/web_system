/* ===== 大橙子个人助理 · 首页（tab 1 / 启动页）=====
 * 设计同源：docs/ui/prototypes/dachengzi-3tab-2026-11-09.html 的 A1 帧。
 * 单位：原型按 375pt 出图，落地按 app.wxss 口径「1px ≈ 2rpx」（16px → 32rpx）。
 * 取色：品牌/表面/文字走 app.wxss 的 token。
 *       2026-11-09：全局 --page-bg / --surface-0 / app.json backgroundColor 已从
 *       暖米（旧值已废弃，见 git 历史）统一改为蓝调浅白 #F5F8FF，本页不再写死色值，
 *       改用 token，否则切 tab 时本页与发现/我的底色会跳变。
 */

page {
  background: var(--page-bg);
}

.page {
  min-height: 100vh;
  background: var(--page-bg);
  /* 自定义 tabBar 不占原生层，页面需自行留出底部空间，否则内容被它盖住 */
  padding: 26rpx 28rpx calc(150rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* ---------- 问候 hero ---------- */
.hero {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 30rpx;
  background: var(--brand-soft);
  border: 1rpx solid var(--brand-100);
  border-radius: var(--r-card);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, .06);
}

.logo {
  flex: 0 0 84rpx;
  width: 84rpx;
  height: 84rpx;
  border-radius: var(--r-card);
  background: var(--brand-txt);
  /* 品牌底上的文字色用 token，不写死 #fff（主题切换时品牌底会变浅） */
  color: var(--on-brand);
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(37, 99, 235, .25);
}

.hero-tx {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.hi {
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: .4rpx;
  color: var(--t1);
}

.hi-sub {
  font-size: 23rpx;
  /* A1 帧 --text-2：#6B7280（冷灰）；全局 --t2 是暖灰半透明，取帧值 */
  color: #6B7280;
}

/* ---------- 今日一句（本地文案池，蓝色系卡片） ---------- */
.daily {
  margin-top: 20rpx;
  padding: 30rpx 32rpx;
  background: var(--card);
  border: 1rpx solid rgba(37, 99, 235, .10);
  border-radius: var(--r-card);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, .06);
}
.daily-k {
  font-size: 22rpx;
  color: var(--brand-txt);
  margin-bottom: 12rpx;
}
.daily-cn {
  font-size: 30rpx;
  color: var(--t1);
  line-height: 1.65;
}
.daily-en {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: var(--t3);
  line-height: 1.6;
}

/* ---------- 新对话快捷入口（hero 区，独立于两条能力入口） ---------- */
.newchat {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 20rpx;
  padding: 26rpx 28rpx;
  background: linear-gradient(120deg, var(--brand-600), var(--brand-500));
  border-radius: var(--r-card);
  box-shadow: 0 8rpx 22rpx rgba(37, 99, 235, .24);
}
.newchat-hover { opacity: .85; }
.n-ic {
  flex: 0 0 60rpx;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, .22);
  color: #fff;
  font-size: 34rpx;
  font-weight: 400;
  display: flex;
  align-items: center;
  justify-content: center;
}
.n-tx { flex: 1; min-width: 0; }
.n-b { font-size: 29rpx; font-weight: 700; color: #fff; }
.n-e { font-size: 22rpx; color: rgba(255, 255, 255, .86); margin-top: 4rpx; }
.n-go { color: #fff; font-size: 36rpx; opacity: .9; flex: 0 0 auto; margin-left: 12rpx; }

/* ---------- 能力入口（两条，与发现页 .cap 同构） ---------- */
.cap {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 20rpx;
  padding: 28rpx;
  background: var(--card);
  border: 1rpx solid rgba(37, 99, 235, .10);
  border-radius: var(--r-card);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, .06);
}

.cap-hover {
  opacity: .75;
}

.ic {
  flex: 0 0 80rpx;
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--r-card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  background: var(--brand-soft);
  color: var(--brand-txt);
}

.tx {
  flex: 1;
  min-width: 0;
}

.tx .b {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--t1);
}

.tx .e {
  font-size: 23rpx;
  color: #6B7280;
  line-height: 1.45;
  margin-top: 6rpx;
}

/* 右侧箭头：用字符而非图标，与发现页 .go 同手法 */
.go {
  font-size: 34rpx;
  color: #B9C1CF;
  margin-left: 12rpx;
  flex: 0 0 auto;
}

/* ---------- 最近对话（会话维度：三态骨架 / 卡片 / 空态） ---------- */
.sec-t {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 36rpx 4rpx 16rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: var(--t1);
}

.sec-t .em {
  font-size: 22rpx;
  font-weight: 400;
  color: #6B7280;
}

.w-recent {
  /* 卡片容器：无额外外边距，间距由 .sec-t 与卡片自身承接 */
}

.wr-item {
  background: var(--card);
  border: 1rpx solid rgba(37, 99, 235, .10);
  border-radius: var(--r-card);
  padding: 24rpx 28rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, .06);
}
.wr-item:active { background: var(--brand-50); }
.wr-q {
  font-size: 26rpx;
  color: var(--t1);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.wr-c {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--t2);
  line-height: 1.55;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.wr-m {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: var(--t3);
}

/* 骨架占位条：最近对话加载中（pulse 动画；中性灰，不引入裸品牌色） */
.sk {
  background: rgba(60, 60, 67, .10);
  border-radius: var(--r-chip);
  animation: sk-pulse 1.3s ease-in-out infinite;
}
.sk-t { width: 54%; height: 22rpx; }
.sk-c1 { width: 100%; height: 24rpx; margin-top: 16rpx; }
.sk-c2 { width: 76%; height: 24rpx; margin-top: 10rpx; }
.sk-m { width: 26%; height: 18rpx; margin-top: 14rpx; }
@keyframes sk-pulse {
  0%, 100% { opacity: .5; }
  50% { opacity: .9; }
}

.empty {
  padding: 34rpx 30rpx;
  text-align: center;
  font-size: 23rpx;
  line-height: 1.85;
  color: #6B7280;
  background: var(--card);
  border: 1rpx solid rgba(37, 99, 235, .10);
  border-radius: var(--r-card);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, .06);
}

/* ---------- 提示行 ---------- */
.hint {
  margin-top: 24rpx;
  padding: 18rpx 22rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #6B7280;
  background: var(--brand-soft);
  border: 1rpx dashed var(--brand-100);
  border-radius: var(--r-control);
}

/* ---------- 合规两行（复用全局 .claim：21rpx = 10.5px、居中） ---------- */
.claim-foot {
  /* 撑到底部：内容短时合规声明仍贴页面下沿，不被上方卡片挤压 */
  margin-top: auto;
  padding-top: 36rpx;
}

.claim-foot .claim {
  /* A1 帧 --compliance：#98A0AE；全局 .claim 用 var(--t3)，此处按帧取值 */
  color: #98A0AE;
}
