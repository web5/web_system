.page { min-height: 100vh; background: #FFFFFF; padding: 28rpx 28rpx 60rpx; color: #1A1A1F; }
.head { margin-bottom: 24rpx; }
.h1 { font-size: 40rpx; font-weight: 700; }
.sub { margin-top: 8rpx; font-size: 24rpx; color: #6B7280; }
.books { display: flex; gap: 12rpx; margin-bottom: 24rpx; }
.book { flex: 1; text-align: center; padding: 14rpx 0; font-size: 26rpx; color: #6B7280; border: 1rpx solid rgba(0,0,0,.08); border-radius: var(--r-control); background: #FFFFFF; }
.book.on { background: #3B82F6; color: #FFFFFF; border-color: #3B82F6; }
.search-wrap { margin-bottom: 24rpx; }
.search { background: #F9FAFB; border: 1rpx solid rgba(0,0,0,.08); border-radius: var(--r-control); padding: 18rpx 24rpx; font-size: 26rpx; }
.grp-t { font-size: 22rpx; color: #6B7280; letter-spacing: 1rpx; margin: 24rpx 0 12rpx; }
.card { border: 1rpx solid rgba(0,0,0,.08); border-radius: var(--r-card); padding: 24rpx 24rpx 20rpx; margin-bottom: 16rpx; background: #FFFFFF; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.04); }
.card:active { background: #EFF6FF; }
.row1 { display: flex; align-items: baseline; }
.no { flex: 0 0 60rpx; color: #0EA5A4; font-size: 26rpx; font-weight: 600; }
.title { flex: 1; font-family: Georgia, serif; font-size: 30rpx; font-weight: 600; }
.go { color: #9CA3AF; font-size: 34rpx; }
.row2 { margin-top: 8rpx; display: flex; align-items: center; gap: 12rpx; }
.cn { font-size: 24rpx; color: #6B7280; }
.tag { font-size: 20rpx; padding: 3rpx 12rpx; border-radius: var(--r-chip); background: #ECFDF5; color: #047857; }
.tag.lrc { background: #EFF6FF; color: #B45309; }
.meta { margin-top: 12rpx; font-size: 22rpx; color: #9CA3AF; }
.state { padding: 80rpx 0; text-align: center; color: #6B7280; font-size: 26rpx; }
.state.err { color: #DC2626; }
