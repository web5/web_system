/* 新概念英语 · 课文详情（整改后：英文课文 + 逐句朗读 + 逐句收藏） */
.page { min-height: 100vh; background: #FFFFFF; color: #1A1A1F; padding: 0 30rpx; }
.bar { display: flex; align-items: center; justify-content: flex-end; padding: 20rpx 0; border-bottom: 1rpx solid rgba(0,0,0,.08); position: sticky; top: 0; background: #FFFFFF; z-index: 5; }
.seg { display: flex; border: 1rpx solid rgba(0,0,0,.08); border-radius: var(--r-control); overflow: hidden; }
.seg-i { padding: 8rpx 14rpx; font-size: 24rpx; color: #6B7280; background: #FFFFFF; }
.seg-i + .seg-i { border-left: 1rpx solid rgba(0,0,0,.08); }
.seg-i.on { background: #3B82F6; color: #FFFFFF; }

.head { padding: 32rpx 0 18rpx; }
.lno { font-size: 22rpx; color: #0EA5A4; letter-spacing: 1rpx; }
.h1 { font-family: Georgia, serif; font-size: 46rpx; line-height: 1.3; margin-top: 8rpx; }
.title-cn { color: #6B7280; font-size: 26rpx; margin-top: 6rpx; }

.sentences { margin-top: 26rpx; }
.sent {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 10rpx;
  min-height: 88rpx;
  border-radius: var(--r-control);
  border-bottom: 1rpx dashed rgba(0,0,0,.10);
}
.sent:active { background: #FAFAFA; }
.sent.reading { background: #EFF6FF; box-shadow: inset 5rpx 0 0 0 #3B82F6; }
.en { flex: 1; min-width: 0; font-family: Georgia, serif; line-height: 1.9; font-size: 32rpx; }
.f0 .en { font-size: 28rpx; }
.f2 .en { font-size: 38rpx; }

.acts { flex: 0 0 auto; display: flex; align-items: center; gap: 24rpx; }
.play { color: #9CA3AF; font-size: 30rpx; }
.play.on { color: #3B82F6; }
.fav { color: #D98200; font-size: 34rpx; padding: 0 8rpx; }
.fav:active { opacity: .6; }

.pager { display: flex; justify-content: space-between; margin-top: 40rpx; }
.pg { font-size: 26rpx; color: #3B82F6; padding: 14rpx 0; }
.pad { height: 140rpx; }
.state { padding: 100rpx 0; text-align: center; color: #6B7280; font-size: 26rpx; }
.state.err { color: #DC2626; }
