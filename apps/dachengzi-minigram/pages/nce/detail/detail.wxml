<!-- 新概念英语 · 课文详情（默认纯英文，中文按需揭示） -->
<view class="page f{{fontStep}} {{radiusClass}}">
  <view class="bar">
    <view class="seg">
      <view class="seg-i {{mode === 'immersion' ? 'on' : ''}}" data-mode="immersion" bindtap="setMode">沉浸</view>
      <view class="seg-i {{mode === 'tap' ? 'on' : ''}}" data-mode="tap" bindtap="setMode">点按</view>
      <view class="seg-i {{mode === 'bilingual' ? 'on' : ''}}" data-mode="bilingual" bindtap="setMode">对照</view>
    </view>
    <view class="seg font">
      <view class="seg-i {{fontStep === 0 ? 'on' : ''}}" data-step="0" bindtap="setFont">A-</view>
      <view class="seg-i {{fontStep === 1 ? 'on' : ''}}" data-step="1" bindtap="setFont">A</view>
      <view class="seg-i {{fontStep === 2 ? 'on' : ''}}" data-step="2" bindtap="setFont">A+</view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="state">加载中…</view>
  <view wx:elif="{{error}}" class="state err" bindtap="onRetry">{{error}}（点击重试）</view>

  <block wx:elif="{{detail}}">
    <view class="head">
      <view class="lno">Lesson {{detail.id}}</view>
      <view class="h1">{{detail.title}}</view>
      <view class="title-cn" wx:if="{{detail.titleCn}}">{{detail.titleCn}}</view>
      <view class="lead" wx:if="{{detail.leadQuestionCn || detail.leadQuestion}}">
        <view class="lead-zh">{{detail.leadQuestionCn || detail.leadQuestion}}</view>
        <view class="lead-en" wx:if="{{detail.leadQuestionCn && detail.leadQuestion}}">{{detail.leadQuestion}}</view>
      </view>
      <view class="src {{detail.textSource}}">{{detail.textSource === 'xdf' ? '权威全文' : '字幕拼接版'}}</view>
    </view>

    <view class="sentences">
      <view wx:if="{{mode === 'tap'}}" class="tap-hint">轻点任意句子看中文，再点一次收起 · 点带虚线的生词查词</view>
      <!-- 外层 si / 内层 ti 显式命名：避免嵌套 wx:for 的默认 index 相互遮蔽，
           否则生词上的 data-i 会拿到 token 下标，揭示错句译文。 -->
      <view wx:for="{{linesView}}" wx:key="idx" wx:for-item="line" wx:for-index="si"
        class="sent {{mode === 'tap' ? 'tappable' : ''}}" data-i="{{si}}" bindtap="toggleLine">
        <view class="en">
          <block wx:for="{{line.tokens}}" wx:for-item="tk" wx:key="k">
            <text wx:if="{{tk.isWord}}" class="w" data-wi="{{tk.wi}}" data-i="{{si}}" catchtap="onWord">{{tk.text}}</text>
            <text wx:else>{{tk.text}}</text>
          </block>
        </view>
        <view wx:if="{{line.cn && (mode === 'bilingual' || line.showCn)}}" class="cn">{{line.cn}}</view>
        <!-- 查词卡就地插在该句下方：不做固定浮层，绝不盖住后面句子的点按区域 -->
        <view wx:if="{{activeWord && wordLineIdx === si}}" class="word-card" catchtap="closeWord">
          <view class="wc-close">×</view>
          <view class="wd">{{activeWord.word}} <text class="ph">{{activeWord.phonetic}}</text></view>
          <view class="df">{{activeWord.pos}} {{activeWord.def}}</view>
          <view wx:if="{{activeWord.example}}" class="eg">{{activeWord.example}}</view>
        </view>
      </view>
    </view>

    <view class="trans">
      <view class="link" bindtap="toggleTrans">{{showTranslation ? '收起参考译文' : '查看参考译文'}}</view>
      <view wx:if="{{showTranslation}}" class="trans-body">{{detail.translation}}</view>
    </view>

    <view class="pager">
      <view class="pg" data-delta="-1" bindtap="goLesson">‹ 上一课</view>
      <view class="pg" data-delta="1" bindtap="goLesson">下一课 ›</view>
    </view>

    <view class="pad" />
  </block>

  <!-- 习题：吸底按钮 + 半屏浮层，读完再展开 -->
  <view class="fab" bindtap="openSheet">开始练习</view>
  <view wx:if="{{exSheet}}" class="scrim" bindtap="closeSheet" />
  <view wx:if="{{exSheet}}" class="sheet" catchtap="noop">
    <view class="sh-head">
      <text class="sh-t">习题</text>
      <text class="sh-x" catchtap="closeSheet">×</text>
    </view>
    <scroll-view scroll-y class="sh-body">
      <block wx:if="{{!exOpen}}">
        <view class="gate">先读完课文，再开始练习。</view>
        <view class="btn" bindtap="startEx">开始练习（{{detail.exercises.length}} 题）</view>
      </block>
      <block wx:else>
        <view wx:for="{{detail.exercises}}" wx:key="index" wx:for-item="q" wx:for-index="qi" class="quiz">
          <view class="q">{{qi + 1}}. {{q.q}}</view>
          <view wx:for="{{q.options}}" wx:key="index" wx:for-item="o" wx:for-index="oi"
            class="opt {{answers[qi] >= 0 && oi === q.answer ? 'right' : ''}} {{answers[qi] === oi && oi !== q.answer ? 'wrong' : ''}}"
            data-qi="{{qi}}" data-oi="{{oi}}" bindtap="choose">
            {{letters[oi]}}. {{o}}
          </view>
          <view wx:if="{{answers[qi] >= 0}}" class="exp {{answers[qi] === q.answer ? 'ok' : ''}}">
            {{answers[qi] === q.answer ? '正确' : '再想想'}} · {{q.exp}}
          </view>
        </view>
      </block>
    </scroll-view>
  </view>
</view>
