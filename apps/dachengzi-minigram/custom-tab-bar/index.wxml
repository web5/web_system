<!-- 自定义 tabBar（app.json: tabBar.custom = true）
     图标为线性图标，与原型 docs/ui/prototypes/dachengzi-3tab-2026-11-09.html 同源。
     2026-11-09 起三格固定为 首页 / 发现 / 我的，全部 isTab=true 走 switchTab；
     对话页已退出 tabBar 集合（普通页，navigateTo 进入，右滑可退回来源页）。 -->
<view class="tabbar">
  <view
    class="tb {{selected === index ? 'on' : ''}}"
    wx:for="{{list}}"
    wx:key="pagePath"
    data-path="{{item.pagePath}}"
    data-index="{{index}}"
    data-istab="{{item.isTab ? 1 : 0}}"
    bindtap="onSwitch"
  >
    <view class="tb-ic tb-ic-{{item.key}}"></view>
    <view class="tb-t">{{item.text}}</view>
  </view>
</view>
