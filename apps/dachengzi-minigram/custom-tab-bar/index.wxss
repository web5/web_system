/* ===== 自定义 tabBar =====
 *
 * 图标设计：与原型 docs/ui/prototypes/dachengzi-3tab-2026-11-09.html 的 tabBar **同源**
 * —— 房子 / 罗盘 / 人像 三个线性图标（24 网格、圆头圆角、stroke-width 1.8），
 * 不用汉字占位、不用彩色块。
 * 小程序 wxss 不支持内联 svg，故转 base64 由 background-image 承载（源码见
 * prototype 内的 symbol：#i-home / #i-compass / #i-user）。
 * 两套配色：未选中 #8A90A0（中性灰，= app.json tabBar.color）。
 * 选中态 stroke = #2563EB（= app.json tabBar.selectedColor），与文字色一致。
 *   ⚠️ 2026-11-09 修正：此前选中态是科豆橙遗留色（#C241**，旧值已废弃，勿再用），造成「字蓝图橙」。
 *   已把 4 个选中态 base64 里的 stroke 统一换成 #2563EB。
 *   🔴 注意：颜色藏在 base64 内，**明文 grep 色值都查不到**（旧值已打码，完整值见 git 历史），
 *   核色必须解码 base64 后看 stroke 值，不能只 grep 源码（这一点曾导致
 *   蓝化改造漏判，务必按解码结果判定）。
 * .tb-ic-chat 已无 list 项引用（对话页 2026-11-09 起退出 tabBar），保留待清理。
 */
.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  background: var(--card, #ffffff);
  border-top: 1rpx solid var(--line, rgba(60, 60, 67, .12));
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 900;
}

.tb {
  flex: 1;
  height: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: 6rpx;
  box-sizing: content-box;
}

/* 图标位：44rpx 见方，与文字保持 4rpx 呼吸 */
.tb-ic {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 4rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 44rpx 44rpx;
}

.tb-t {
  font-size: 20rpx;
  line-height: 1.2;
  color: #8a90a0;
}

.tb.on .tb-t {
  color: var(--brand-txt, #1D4ED8);
  font-weight: 600;
}

/* ---------- 未选中（#8A90A0） ---------- */
.tb-ic-home {
  background-image: url("data:image/svg+xml;base64,");
}
.tb-ic-chat {
  background-image: url("data:image/svg+xml;base64,");
}
.tb-ic-discover {
  background-image: url("data:image/svg+xml;base64,");
}
.tb-ic-mine {
  background-image: url("data:image/svg+xml;base64,");
}

/* ---------- 选中（stroke = #2563EB，与 app.json selectedColor 及文字色一致；见文件头说明） ---------- */
