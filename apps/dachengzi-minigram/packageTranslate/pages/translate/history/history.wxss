/* 翻译历史页 —— 与结果页同一套蓝色系 token（app.wxss 的 --brand-* 系）。
 * 页面底色按规格取 #F5F8FF（与全站暖灰 --page-bg 区分），新增页面统一。 */
.page { min-height: 100vh; background: #F5F8FF; padding: 24rpx 32rpx 40rpx; }

.hd { display: flex; align-items: center; justify-content: space-between; padding: 8rpx 4rpx 20rpx; }
.hd-t { font-size: 26rpx; font-weight: 600; color: var(--t1); }
.hd-c { font-size: 23rpx; color: var(--t3); padding: 6rpx 4rpx; }
.hd-c:active { color: var(--brand-txt); }

.list {
  background: var(--card);
  border: 1rpx solid rgba(37, 99, 235, .10);
  border-radius: var(--r-card);
  overflow: hidden;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, .06);
}
.r { display: flex; align-items: center; padding: 26rpx 28rpx; border-bottom: 1rpx solid rgba(37, 99, 235, .08); }
.r:last-child { border-bottom: none; }
.r:active { background: var(--brand-50); }
.rl { flex: 1; min-width: 0; }
.r-title {
  display: block;
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--t1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.r-sub { display: block; margin-top: 8rpx; font-size: 22rpx; color: var(--t3); }
.r-arrow { flex: none; margin-left: 16rpx; font-size: 32rpx; color: var(--t3); }

.foot { margin-top: 22rpx; font-size: 21rpx; color: #98A0AE; text-align: center; }

/* ---------- 空态 ---------- */
.empty { padding: 120rpx 0 0; display: flex; flex-direction: column; align-items: center; }
.ill { position: relative; width: 240rpx; height: 168rpx; margin-bottom: 36rpx; }
.ill-bubble {
  position: absolute;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: var(--r-card);
}
.ill-b1 {
  left: 0; top: 8rpx; width: 104rpx; height: 74rpx;
  background: var(--brand-50); color: var(--brand-txt);
  border-radius: var(--r-card) var(--r-card) var(--r-chip) var(--r-card);
}
.ill-b2 {
  right: 0; bottom: 12rpx; width: 96rpx; height: 70rpx;
  background: var(--card); color: var(--t3);
  border: 1rpx solid rgba(37, 99, 235, .14);
  border-radius: var(--r-card) var(--r-card) var(--r-card) var(--r-chip);
}
.ill-line { position: absolute; left: 104rpx; top: 96rpx; width: 56rpx; height: 2rpx; background: rgba(37, 99, 235, .18); transform: rotate(-18deg); }

.et { font-size: 30rpx; font-weight: 600; color: var(--t1); }
.es { margin-top: 12rpx; font-size: 24rpx; color: var(--t3); }
.ebtn {
  margin-top: 40rpx;
  min-width: 280rpx;
  height: 84rpx;
  padding: 0 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--brand-600);
  color: var(--on-brand);
  font-size: 28rpx;
  border-radius: var(--r-pill);
  box-shadow: 0 6rpx 18rpx rgba(37, 99, 235, .22);
}
.ebtn:active { opacity: .88; }
