{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    // paths 把 @web-system/shared 指向**源码**，vue-tsc 会连带检查 shared 的实体类
    //（TypeORM 装饰器）。缺这三项会报 TS1240 / TS2564（2026-09-15 首次构建 shell 时暴露）。
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@web-system/shared": ["../../packages/shared/src/index.ts"],
      "@web-system/shell-loader": ["../../packages/shell-loader/src/index.ts"]
    },
    "types": ["node"]
  },
  "include": ["src/**/*", "src/**/*.vue"],
  "exclude": ["node_modules", "dist"]
}
