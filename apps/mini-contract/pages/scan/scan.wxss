.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  padding: 8vh 6%;
  background: linear-gradient(180deg, #FFFBF5 0%, #FFF8F0 100%);
}

.app-logo {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.logo-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #FF8C42;
  margin-top: 16rpx;
}

.scan-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.scan-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 16rpx;
}

.scan-tip {
  font-size: 28rpx;
  color: #888888;
  margin-bottom: 60rpx;
  text-align: center;
}

.action-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  padding: 80rpx 40rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.scan-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 40rpx;
}

.scan-icon.loading {
  animation: rotate 1.5s linear infinite;
}

@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.action-hint {
  font-size: 32rpx;
  color: #333333;
  text-align: center;
  margin-bottom: 24rpx;
}

.action-sub {
  font-size: 26rpx;
  color: #888888;
  text-align: center;
}

.success-text {
  color: #7ED957;
  font-weight: 600;
}

.fail-text {
  color: #FF5252;
  font-weight: 600;
}

.scan-btn {
  margin-top: 40rpx;
  width: 80%;
  height: 96rpx;
  line-height: 96rpx;
  background: #FF8C42;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  border: none;
}

.scan-btn::after {
  border: none;
}
