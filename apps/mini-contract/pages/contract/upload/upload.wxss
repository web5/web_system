/* 合同翻译官 - 上传页（按 v5 原型稿还原） */
page {
  background: #F5F7FA;
}
.page {
  padding: 32rpx 32rpx 60rpx;
}

/* 拍照 / 相册 双大按钮 */
.up-actions {
  display: flex;
  gap: 24rpx;
  margin-bottom: 28rpx;
}
.up-act {
  flex: 1;
  background: #fff;
  border: 3rpx dashed #1E6FFF;
  border-radius: 32rpx;
  padding: 36rpx 16rpx;
  text-align: center;
  box-sizing: border-box;
}
.up-act-hover {
  background: #EAF2FF;
}
.up-act .ua-ic { font-size: 52rpx; line-height: 1.2; }
.up-act .ua-t {
  display: block;
  margin-top: 12rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: #1A1F2E;
}
.up-act .ua-d {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #9AA1AD;
  line-height: 1.4;
}

.up-or {
  text-align: center;
  font-size: 22rpx;
  color: #9AA1AD;
  margin-bottom: 24rpx;
}

/* 文本粘贴 */
.up-text {
  width: 100%;
  min-height: 236rpx;
  background: #fff;
  border: 3rpx solid #E8EBF0;
  border-radius: 24rpx;
  padding: 24rpx;
  box-sizing: border-box;
  font-size: 24rpx;
  line-height: 1.7;
  color: #1A1F2E;
}
.up-text-ph { color: #B7BDC9; }

/* 示例合同 chips */
.up-samples {
  margin-top: 28rpx;
}
.sl {
  font-size: 24rpx;
  color: #5B6372;
  margin-bottom: 16rpx;
  font-weight: 600;
}
.samples {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}
.sample {
  font-size: 24rpx;
  color: #1E6FFF;
  background: #EAF2FF;
  border: 1rpx solid #C9DFFF;
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
}

/* 场景 chips */
.up-scene {
  margin-top: 28rpx;
}
.scene-chips {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}
.scene-chip {
  font-size: 24rpx;
  color: #5B6372;
  background: #fff;
  border: 3rpx solid #E8EBF0;
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
}
.scene-chip.active {
  color: #1E6FFF;
  border-color: #1E6FFF;
  background: #EAF2FF;
  font-weight: 600;
}

/* 主按钮 */
.btn-primary {
  margin-top: 40rpx;
  background: #1E6FFF;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 24rpx;
  border: none;
  line-height: 2.2;
}
.btn-primary::after {
  border: none;
}
.btn-primary[disabled] {
  background: #A9C9FF;
  color: #fff;
}

.up-note {
  margin-top: 28rpx;
  text-align: center;
  font-size: 22rpx;
  color: #9AA1AD;
  line-height: 1.6;
}
