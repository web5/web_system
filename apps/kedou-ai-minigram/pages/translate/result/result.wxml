<view class="page">
  <view class="srcbox">
    <text class="k">原文</text>
    <text class="v">{{source}}</text>
  </view>

  <view class="res">
    <view class="tags"><text class="tag">推荐</text><text class="meta">{{meta}}</text></view>
    <view class="txt">{{natural}}</view>
    <view class="ops">
      <text bindtap="copy">复制</text>
      <text bindtap="speak">朗读</text>
      <text bindtap="fav">收藏</text>
      <text bindtap="more">更多</text>
    </view>
  </view>

  <view class="fold">
    <view class="h" bindtap="toggleFold">
      <text>直译对照 · 委婉版 · 语气要点</text>
      <text class="act">{{open ? '收起' : '展开'}}</text>
    </view>
    <view class="c" wx:if="{{open}}">
      <view class="m"><view class="k">直译对照</view><view class="v">{{literal}}</view></view>
      <view class="m"><view class="k">委婉版</view><view class="v">{{polite}}</view></view>
      <view class="m"><view class="k">语气要点</view><view class="v">{{notes}}</view></view>
    </view>
  </view>

  <view class="vip" bindtap="goVip"><text>深度润色（旗舰模型）</text><text>会员 ›</text></view>
  <view class="rowbtn">
    <view bindtap="goBack">重新翻译</view>
    <view bindtap="share">生成分享卡</view>
  </view>
  <view class="ai">内容由 AI 生成，仅供参考</view>
</view>
