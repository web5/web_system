/* 对话记录页：会话列表 + 下拉分页 */
.page {
  min-height: 100vh;
  background: var(--page-bg);
  padding: 24rpx 0;
  box-sizing: border-box;
}

.list {
  margin: 0 24rpx;
  background: var(--card);
  border-radius: var(--r-card);
  overflow: hidden;
}

.row {
  padding: 26rpx 28rpx;
  border-bottom: 1rpx solid var(--line);
}
.row:last-child { border-bottom: none; }
.row:active { background: var(--brand-50); }

.row-t {
  font-size: 28rpx;
  color: var(--t1);
  line-height: 1.5;
  /* 标题最多两行，超出截断（历史标题可能很长） */
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.row-m {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--t3);
}

/* 骨架占位条：加载中的占位（pulse 动画；色值用 --t3 token，不引入裸 hex） */
.sk {
  background: var(--t3);
  border-radius: var(--r-chip);
  animation: sk-pulse 1.3s ease-in-out infinite;
}
.sk-t { width: 70%; height: 26rpx; }
.sk-m { width: 30%; height: 20rpx; margin-top: 12rpx; }
@keyframes sk-pulse {
  0%, 100% { opacity: .5; }
  50% { opacity: .9; }
}

.tip {
  text-align: center;
  font-size: 24rpx;
  color: var(--t3);
  padding: 32rpx 0;
}
.tip.err { color: var(--red); }

.empty {
  text-align: center;
  font-size: 26rpx;
  color: var(--t3);
  padding: 180rpx 0;
}
