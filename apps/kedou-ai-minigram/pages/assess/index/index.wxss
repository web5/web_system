.page { min-height: 100vh; background: #F2F4F8; padding: 24rpx 32rpx 40rpx; }
.upload { background: #fff; border-radius: 28rpx; padding: 40rpx 32rpx; text-align: center; border: 2rpx dashed #DDE2EA; }
.t { font-size: 29rpx; font-weight: 500; }
.d { font-size: 23rpx; color: #C0C6D0; margin-top: 6rpx; }
.urow { display: flex; margin-top: 22rpx; }
.urow view { flex: 1; height: 80rpx; border-radius: 40rpx; background: #fff; display: flex; align-items: center; justify-content: center; font-size: 25rpx; color: #6B7280; margin-right: 18rpx; }
.urow view:last-child { margin-right: 0; }
.sec-t { font-size: 25rpx; color: #6B7280; margin: 32rpx 0 16rpx; display: flex; justify-content: space-between; }
.em { font-size: 23rpx; color: #C0C6D0; }
.chips { white-space: nowrap; }
.chip { display: inline-block; font-size: 25rpx; padding: 12rpx 26rpx; border-radius: 16rpx; background: #fff; color: #6B7280; margin-right: 14rpx; }
.chip.on { background: #1E6FFF; color: #fff; }
.btn { height: 92rpx; border-radius: 46rpx; background: #1E6FFF; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 32rpx; margin-top: 36rpx; }
.list { background: #fff; border-radius: 24rpx; overflow: hidden; }
.r { display: flex; justify-content: space-between; align-items: center; padding: 28rpx; border-bottom: 1rpx solid #EEF0F4; font-size: 28rpx; }
.r:last-child { border-bottom: none; }
.v { color: #9AA1AD; font-size: 26rpx; }
.ai { margin-top: 28rpx; font-size: 21rpx; color: #C0C6D0; text-align: center; }
