.page { min-height: 100vh; background: #F2F4F8; padding: 24rpx 32rpx 40rpx; }
.score { display: flex; align-items: center; background: #fff; border-radius: 28rpx; padding: 32rpx; }
.ring { width: 148rpx; height: 148rpx; border-radius: 50%; background: conic-gradient(#D98200 0 62%, #EEF0F4 62% 100%); display: flex; flex-direction: column; align-items: center; justify-content: center; }
.ring .n { font-size: 44rpx; font-weight: 600; color: #D98200; }
.ring .l { font-size: 18rpx; color: #C0C6D0; }
.info { flex: 1; margin-left: 30rpx; }
.lv { font-size: 31rpx; font-weight: 600; color: #D98200; }
.d { font-size: 24rpx; color: #6B7280; margin-top: 6rpx; line-height: 1.6; }
.sec-t { font-size: 25rpx; color: #6B7280; margin: 32rpx 0 16rpx; }
.risk { background: #fff; border-radius: 24rpx; padding: 26rpx 28rpx; margin-bottom: 16rpx; }
.rh { display: flex; align-items: center; margin-bottom: 12rpx; }
.badge { font-size: 20rpx; padding: 4rpx 12rpx; border-radius: 8rpx; margin-right: 12rpx; }
.high { background: #FDECEC; color: #E5484D; }
.mid { background: #FFF6E5; color: #D98200; }
.low { background: #E7F7EE; color: #12A150; }
.b { font-size: 27rpx; font-weight: 500; flex: 1; }
.rc { font-size: 25rpx; color: #6B7280; line-height: 1.7; }
.rf { font-size: 23rpx; color: #1E6FFF; margin-top: 12rpx; padding-top: 12rpx; border-top: 1rpx solid #EEF0F4; }
.rowbtn { display: flex; margin-top: 24rpx; }
.rowbtn view { flex: 1; height: 84rpx; border-radius: 42rpx; background: #fff; display: flex; align-items: center; justify-content: center; font-size: 27rpx; margin-right: 18rpx; }
.rowbtn view:last-child { margin-right: 0; }
.ai { margin-top: 28rpx; font-size: 21rpx; color: #C0C6D0; text-align: center; }
