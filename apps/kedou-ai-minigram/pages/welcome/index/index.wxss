/* ===== 科豆 AI - 欢迎页（启动页，非 tab） ===== */
page {
  background: var(--page-bg);
}

.page {
  min-height: 100vh;
  background: var(--page-bg);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  /* 手动挂载的自定义 tabBar 不占原生层，页面需自行留出底部空间 */
  padding: 140rpx 48rpx calc(150rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.w-hello {
  font-size: 88rpx;
  font-weight: 600;
  letter-spacing: -2rpx;
  color: var(--t1);
  line-height: 1.2;
}
.w-hello .dot { color: var(--brand); }

.w-sub {
  margin-top: 14rpx;
  font-size: 27rpx;
  color: var(--t3);
}

/* 今日一句（与对话页首条同文案，来自 utils/daily.ts） */
.w-quote {
  margin-top: 64rpx;
  background: var(--card);
  border-radius: 28rpx;
  padding: 34rpx 32rpx;
  box-shadow: 0 8rpx 28rpx rgba(20, 30, 60, .06);
}
.w-quote .k {
  font-size: 22rpx;
  color: var(--brand-txt);
  margin-bottom: 14rpx;
}
.w-quote .cn {
  font-size: 32rpx;
  color: var(--t1);
  line-height: 1.65;
}
/* 最近对话：欢迎页的会话快捷入口（点卡片进入对应会话） */
.w-recent {
  margin-top: 28rpx;
}
.wr-t {
  font-size: 22rpx;
  color: var(--t3);
  margin-bottom: 12rpx;
}
.wr-item {
  background: var(--card);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, .04);
}
.wr-item:active { background: var(--brand-50); }
.wr-q {
  font-size: 26rpx;
  color: var(--t1);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
/* 骨架占位条：最近对话加载中（pulse 动画；色值用 --t3 token，不引入裸 hex） */
.sk {
  background: var(--t3);
  border-radius: 6rpx;
  animation: sk-pulse 1.3s ease-in-out infinite;
}
.sk-t { width: 54%; height: 22rpx; }
.sk-c1 { width: 100%; height: 24rpx; margin-top: 14rpx; }
.sk-c2 { width: 76%; height: 24rpx; margin-top: 10rpx; }
.sk-m { width: 26%; height: 18rpx; margin-top: 14rpx; }
@keyframes sk-pulse {
  0%, 100% { opacity: .5; }
  50% { opacity: .9; }
}

/* 最近一条对话的内容截取（次要层级：标题在上、内容居中、时间在下） */
.wr-c {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--t2);
  line-height: 1.55;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.wr-m {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--t3);
}

.w-quote .en {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--t3);
  line-height: 1.6;
}

.btn {
  height: 96rpx;
  border-radius: 48rpx;
  background: var(--brand);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(249, 115, 22, .28);
}
.btn:active { opacity: .85; }

.w-foot .claim { margin-top: 26rpx; }
