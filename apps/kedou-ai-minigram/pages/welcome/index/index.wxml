<!-- 科豆 AI · 欢迎页（启动页，非 tab 页）
     手动引入自定义 tabBar：本页是进入「发现 / 我的」的枢纽。
     对话页才是沉浸式（隐藏 tabBar），其顶部返回 icon 回到本页。 -->
<view class="page">
  <view class="w-group">
    <view class="w-hello">Hello<text class="dot">.</text></view>
    <view class="w-sub">科豆 AI · 体验不一样的 AI</view>

    <view class="w-quote">
      <view class="k">今日一句</view>
      <view class="cn">{{quote.cn}}</view>
      <view class="en">{{quote.en}}</view>
    </view>

    <!-- 最近对话 · 加载中：骨架占位（尺寸对齐真实卡片，切换时不跳动） -->
    <view wx:if="{{recentLoading}}" class="w-recent">
      <view class="wr-t">最近对话</view>
      <view class="wr-item">
        <view class="sk sk-t"></view>
        <view class="sk sk-c1"></view>
        <view class="sk sk-c2"></view>
        <view class="sk sk-m"></view>
      </view>
    </view>

    <!-- 最近对话 · 加载完成：只展示最近一次会话的最近一条对话，点击进入并聚焦到最新一条 -->
    <view wx:elif="{{recent}}" class="w-recent">
      <view class="wr-t">最近对话</view>
      <view class="wr-item" data-id="{{recent.id}}" bindtap="openConv">
        <view class="wr-q">{{recent.title}}</view>
        <view wx:if="{{recent.preview}}" class="wr-c">{{recent.preview}}</view>
        <view class="wr-m">{{recent.timeText}}</view>
      </view>
    </view>
  </view>

  <view class="w-foot">
    <view class="btn" bindtap="startChat">开始对话</view>
    <view class="claim">内容由 AI 生成，仅供参考，不构成法律意见
已依法完成大模型与算法备案</view>
  </view>
</view>

<!-- 自定义 tabBar：非 tab 页框架不会自动注入，这里手动挂载 -->
<custom-tab-bar id="tabbar" />
