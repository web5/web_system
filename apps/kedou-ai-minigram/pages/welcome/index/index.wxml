<!-- 欢迎页（启动页 / 非 tab 页，不显示 tabBar） -->
<view class="page">
  <view class="hero">
    <view class="brand">
      <view class="mark">科</view>
      <text>科豆 AI · kedou-ai-minigram</text>
    </view>
    <view class="title">欢迎进入科豆 AI</view>
    <view class="sub">科豆 AI · 体验不一样的 AI</view>
  </view>

  <view class="main">
    <view class="panel">今天想先做什么？</view>
    <view class="desc">两个能力共用一个账号，数据各自独立</view>
    <view class="entry">
      <view class="e" bindtap="goTranslate">
        <view class="ic ic-tr">译</view>
        <view class="n">AI 翻译</view>
        <view class="d">中英日德 · 得体表达</view>
      </view>
      <view class="e" bindtap="goAssess">
        <view class="ic ic-as">同</view>
        <view class="n">合同评估</view>
        <view class="d">风险识别 · 条款解读</view>
      </view>
    </view>
  </view>

  <view class="recent">
    <view class="sec-t">最近使用<text class="em">仅本机保留 30 天</text></view>
    <view class="it" wx:for="{{recent}}" wx:key="id" bindtap="openRecent" data-type="{{item.type}}">
      <text class="tag {{item.type === 'translate' ? 'tr' : 'as'}}">{{item.type === 'translate' ? '翻译' : '评估'}}</text>
      <text class="tt">{{item.title}}</text>
      <text class="tm">{{item.time}}</text>
    </view>
    <view class="empty" wx:if="{{recent.length === 0}}">暂无记录</view>
  </view>

  <view class="foot">
    <view class="btn-ghost" bindtap="goTranslate">进入主界面</view>
    <view class="claim">内容由 AI 生成，仅供参考，不构成法律意见</view>
  </view>
</view>
