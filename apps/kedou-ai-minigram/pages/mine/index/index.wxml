<!-- 科豆 AI · 我的（tab 3）：设置收敛为分组 -->
<!-- 会话归属按「完全隔离」口径：各应用历史 与 主对话记录 分列，不混成一个列表 -->
<view class="page {{radiusClass}} {{loggedIn ? '' : 'locked'}}">
  <!-- 未登录：整页只渲染登录引导卡（Q1 必须登录才可用），不发任何业务请求 -->
  <login-gate wx:if="{{!loggedIn}}" desc="口味记忆、生词本与手机号都跟着账号走" agreement-url="/pages/mine/agreement/agreement" bind:logged="onLogged" />

  <block wx:if="{{loggedIn}}">
  <view class="profile" bindtap="goProfile">
    <view class="avatar">豆</view>
    <view class="info">
      <view class="n">{{nickname}}</view>
      <view class="d">{{realName}} · {{phone}}</view>
    </view>
    <text class="arw">›</text>
  </view>

  <view class="vip" bindtap="goVip">
    <view class="a">专业版</view>
    <view class="b">深度润色 · 术语库 · 合同不限次评估</view>
  </view>

  <!-- AI 记忆：用户级、跨会话；口味只是第一个类目，后续可复用该分组 -->
  <view class="sec-t">AI 记忆<text class="em">跨会话生效</text></view>
  <view class="list">
    <view class="r" bindtap="goTaste">
      <text class="nm">音乐口味</text><text class="v">{{tasteSummary}} ›</text>
    </view>
    <view class="r" bindtap="goMemory">
      <text class="nm">用户记忆</text><text class="v">{{memorySummary}} ›</text>
    </view>
  </view>

  <view class="sec-t">应用设置<text class="em">各管各的</text></view>
  <view class="list">
    <view class="r" bindtap="goTrSettings">
      <text class="nm">语言翻译官</text><text class="v">默认语气 · 术语库 ›</text>
    </view>
    <view class="r" bindtap="goAsSettings">
      <text class="nm">合同评估</text><text class="v">严格度 · 关注风险点 ›</text>
    </view>
  </view>

  <view class="sec-t">通用</view>
  <view class="list">
    <view class="r" bindtap="goAppSettings"><text>小程序设置</text><text class="v">›</text></view>
    <view class="r" bindtap="onNotify"><text>消息通知</text><text class="v">已开启 ›</text></view>
    <view class="r" bindtap="clearCache"><text>清除缓存</text><text class="v">{{cacheSize}} ›</text></view>
  </view>

  <view class="sec-t">我的数据</view>
  <view class="list">
    <view class="r" bindtap="goGlossary">
      <text>生词本</text><text class="v">{{glossarySummary}} ›</text>
    </view>
    <view class="r" bindtap="goHistory">
      <text>我的翻译</text><text class="v">{{trCount ? trCount + ' 条' : ''}} ›</text>
    </view>
    <view class="r" bindtap="goContracts">
      <text>我的合同</text><text class="v">{{asCount ? asCount + ' 份' : ''}} ›</text>
    </view>
    <view class="r" bindtap="goChats">
      <text>对话记录</text><text class="v">{{chatCount ? chatCount + ' 条' : ''}} ›</text>
    </view>
  </view>

  <view class="list">
    <view class="r" bindtap="goAgreement"><text>用户协议与隐私政策</text><text class="v">›</text></view>
    <view class="r" bindtap="goAbout"><text>关于科豆 AI</text><text class="v">v1.0.0 ›</text></view>
  </view>

  <view class="logout" bindtap="logout">退出登录</view>
  </block>

  <view class="foot">本服务使用生成式人工智能
已依法完成大模型与算法备案</view>
</view>
