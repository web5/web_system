<view class="page">
  <view class="profile">
    <view class="avatar">橙</view>
    <view class="info">
      <view class="n">{{nickname}}</view>
      <view class="d">ID: {{uid}} · {{joinedAt}} 加入</view>
    </view>
  </view>

  <view class="list">
    <view class="r" bindtap="editNickname"><text>昵称</text><text class="v">{{nickname}} ›</text></view>
    <view class="r" bindtap="editPhone"><text>手机号</text><text class="v">{{phone}} ›</text></view>
    <view class="r" bindtap="bindEmail"><text>邮箱</text><text class="v">{{email}} ›</text></view>
    <view class="r" bindtap="goVerify"><text>实名认证</text><text class="v">{{realName}} ›</text></view>
    <view class="r" bindtap="bindWechat"><text>微信账号</text><text class="v">已绑定 ›</text></view>
  </view>

  <view class="foot">实名信息用于合同评估的合规留痕</view>
</view>
