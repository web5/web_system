/* 音乐口味页：色值走 app.wxss token，间距取 8 的倍数（rpx 双倍） */
page { background: var(--page-bg); }

.page {
  min-height: 100vh;
  background: var(--page-bg);
  padding: 24rpx 32rpx calc(64rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.loading { padding: 80rpx 0; text-align: center; font-size: 26rpx; color: var(--t3); }

.grp {
  background: var(--card);
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
}
.gh {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  font-size: 25rpx;
  color: var(--t2);
  margin-bottom: 20rpx;
}
.gh .tip { font-size: 22rpx; color: var(--t3); }

.tags { display: flex; flex-wrap: wrap; }
.tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 25rpx;
  padding: 12rpx 20rpx;
  border-radius: 16rpx;
  background: var(--brand-soft);
  color: var(--brand-txt);
  margin: 0 16rpx 16rpx 0;
}
.tag.dis { background: var(--red-soft); color: var(--red); }
.tag .pre { font-size: 20rpx; opacity: .75; }
.tag .lb { line-height: 1; }
.tag .x {
  width: 28rpx;
  height: 28rpx;
  position: relative;
  opacity: .7;
}
.tag .x1, .tag .x2 {
  position: absolute;
  left: 3rpx;
  top: 13rpx;
  width: 22rpx;
  height: 2rpx;
  background: currentColor;
  border-radius: 1rpx;
}
.tag .x1 { transform: rotate(45deg); }
.tag .x2 { transform: rotate(-45deg); }

.add { display: flex; gap: 16rpx; }
.ipt {
  flex: 1;
  height: 72rpx;
  border-radius: 16rpx;
  border: 1rpx solid var(--line);
  background: var(--page-bg);
  padding: 0 24rpx;
  font-size: 26rpx;
  color: var(--t1);
}
.ipt.err { border-color: var(--red); }
.btn-a {
  flex: none;
  height: 72rpx;
  padding: 0 28rpx;
  border-radius: 16rpx;
  background: var(--brand-soft);
  color: var(--brand-txt);
  font-size: 26rpx;
  display: flex;
  align-items: center;
}
.btn-a:active { opacity: .8; }
.ferr { font-size: 23rpx; color: var(--red); margin-top: 12rpx; }

.danger {
  margin-top: 32rpx;
  height: 88rpx;
  border-radius: 24rpx;
  border: 1rpx solid var(--line);
  background: var(--card);
  color: var(--red);
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.danger:active { opacity: .8; }

.foot {
  margin-top: 40rpx;
  font-size: 21rpx;
  color: var(--t3);
  text-align: center;
  line-height: 1.9;
}

.empty { padding: 120rpx 40rpx; text-align: center; }
.ico {
  width: 88rpx;
  height: 88rpx;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  background: var(--brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
}
.ico-note {
  width: 44rpx;
  height: 44rpx;
  border-left: 6rpx solid var(--brand-txt);
  border-right: 6rpx solid var(--brand-txt);
  border-radius: 4rpx;
}
.e1 { font-size: 28rpx; color: var(--t1); }
.e2 { font-size: 25rpx; color: var(--t2); margin-top: 12rpx; }
.go {
  margin-top: 32rpx;
  display: inline-flex;
  height: 72rpx;
  padding: 0 32rpx;
  border-radius: 36rpx;
  background: var(--brand);
  color: #fff;
  font-size: 26rpx;
  align-items: center;
}
.go:active { opacity: .88; }
