/* 登录引导卡：铺满所在页面（页面容器需为 relative），未登录态整页拦截 */
.gate {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 100;
  background: var(--page-bg);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 32px;
  text-align: center;
}
.gate-ic {
  width: 56px;
  height: 56px;
  border-radius: 28px;
  background: var(--brand-soft);
  color: var(--brand-txt);
  font-size: 22px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16px;
}
.gate-t {
  font-size: 16px;
  font-weight: 600;
  color: var(--t1);
}
.gate-d {
  margin-top: 8px;
  font-size: 12.5px;
  color: var(--t2);
  line-height: 1.6;
}
.gate-btn {
  margin-top: 24px;
  width: 100%;
  max-width: 224px;
  height: 40px;
  border-radius: 20px;
  background: var(--brand);
  color: var(--on-brand, #fff);
  font-size: 14px;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}
.gate-note {
  margin-top: 16px;
  font-size: 11px;
  color: var(--t2);
  line-height: 1.6;
}
.gate-link {
  color: var(--brand-txt);
}
