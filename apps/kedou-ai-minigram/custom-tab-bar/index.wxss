/* ===== 自定义 tabBar =====
 *
 * 图标设计：与原型 prototype/index.html 的 tabBar **同源** —— 聊天气泡 / 罗盘 / 人像
 * 三个线性图标（24 网格、圆头圆角、stroke-width 1.8），不用汉字占位、不用彩色块。
 * 小程序 wxss 不支持内联 svg，故转 base64 由 background-image 承载；
 * 选中 / 未选中两套配色（#C2410C 品牌橙深档 / #8A90A0 中性灰），对比度均达标。
 */
.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  background: var(--card, #ffffff);
  border-top: 1rpx solid var(--line, rgba(60, 60, 67, .12));
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 900;
}

.tb {
  flex: 1;
  height: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: 6rpx;
  box-sizing: content-box;
}

/* 图标位：44rpx 见方，与文字保持 4rpx 呼吸 */
.tb-ic {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 4rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 44rpx 44rpx;
}

.tb-t {
  font-size: 20rpx;
  line-height: 1.2;
  color: #8a90a0;
}

.tb.on .tb-t {
  color: var(--brand-txt, #c2410c);
  font-weight: 600;
}

