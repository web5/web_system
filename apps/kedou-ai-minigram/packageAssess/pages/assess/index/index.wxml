<view class="page {{radiusClass}}">
  <view class="upload" bindtap="chooseFile">
    <view class="t">上传或粘贴合同</view>
    <view class="d">支持 PDF / Word / 图片 / 直接粘贴文本</view>
  </view>

  <view class="urow">
    <view bindtap="takePhoto">拍照</view>
    <view bindtap="chooseAlbum">相册</view>
    <view bindtap="chooseFile">文件</view>
  </view>

  <view class="sec-t">合同类型</view>
  <scroll-view class="chips" scroll-x>
    <view class="chip {{contractType === item ? 'on' : ''}}" wx:for="{{types}}" wx:key="*this" data-v="{{item}}" bindtap="pickType">{{item}}</view>
  </scroll-view>

  <view class="sec-t">关注风险点<text class="em">可多选</text></view>
  <scroll-view class="chips" scroll-x>
    <view class="chip {{item.on ? 'on' : ''}}" wx:for="{{risks}}" wx:key="name" data-i="{{index}}" bindtap="toggleRisk">{{item.name}}</view>
  </scroll-view>

  <view class="btn" bindtap="start">开始评估</view>

  <view class="sec-t">最近评估</view>
  <view class="list">
    <view class="r" bindtap="openResult"><text>设备采购合同_2026Q3</text><text class="v">62 分 · 昨天 ›</text></view>
    <view class="r" bindtap="openResult"><text>办公室租赁合同</text><text class="v">81 分 · 3 天前 ›</text></view>
  </view>

  <view class="ai">评估结果由 AI 生成，仅供参考，不构成法律意见</view>
</view>
