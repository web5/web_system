<!-- 合同翻译官 - 解读中 -->
<view class="page">
  <!-- 转圈（唯一总 loading） -->
  <view class="ring-wrap">
    <view class="ring"></view>
    <view class="ring-center">
      <text class="ring-ic">盾</text>
    </view>
  </view>

  <text class="title">正在为你体检合同</text>
  <!-- 动态子标题：思考中/执行中/报告字数 -->
  <text class="sub">{{thinkingText}}</text>

  <!-- AI 思考卡：思考内容流式呈现；执行开始后自动收起为一行摘要；点击标题可展开/收起 -->
  <view class="think-card {{think.open ? 'open' : 'collapsed'}}" bindtap="toggleThink">
    <view class="think-hd">
      <text class="think-ic">🤔</text>
      <text class="think-t">{{think.done ? 'AI 已完成思考' : 'AI 正在思考…'}}</text>
      <text class="think-state {{think.done ? '' : 'ing'}}">{{think.done ? '完成' : '思考中'}}</text>
      <text class="think-chev">⌄</text>
    </view>
    <view class="think-bd">
      <scroll-view scroll-y class="think-body" enable-flex scroll-top="{{thinkScrollTop}}">
        <text class="think-text" space="nbsp">{{think.text}}</text>
      </scroll-view>
    </view>
  </view>

  <!-- 执行步骤：思考完成（首个 tool_call）后才出现；pending 灰 → running 蓝 → done 绿 -->
  <view class="tool-steps" wx:if="{{toolSteps.length}}">
    <view wx:for="{{toolSteps}}" wx:key="id" class="tool-step {{item.status}}">
      <text class="tool-step-ic">{{item.status === 'done' ? '✅' : item.status === 'running' ? '🔧' : '○'}}</text>
      <text class="tool-step-text">{{item.hint}}</text>
      <text class="tool-step-state">
        {{item.status === 'pending' ? '待执行' : item.status === 'running' ? '进行中…' : '完成'}}
      </text>
    </view>
  </view>
</view>
