/* ===== 合同翻译官 - 解读中 ===== */
/* 显式覆盖 app.wxss 的全局黑色 page 背景，避免重编译瞬间黑屏 */
page {
  background: #fff;
}

.page {
  min-height: 100vh;
  background: #fff;
  padding: 60rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 转圈 */
.ring-wrap {
  position: relative;
  width: 220rpx;
  height: 220rpx;
  margin-bottom: 48rpx;
}
.ring {
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  border: 10rpx solid #EAF2FF;
  border-top-color: #1E6FFF;
  animation: spin 1s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
.ring-center {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ring-ic {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #EAF2FF;
  color: #1E6FFF;
  font-size: 36rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1F2E;
}
.sub {
  font-size: 26rpx;
  color: #9AA1AD;
  margin-top: 12rpx;
  margin-bottom: 56rpx;
}

/* 步骤 */
.step-list {
  width: 100%;
}
.step {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 0;
  opacity: 0.5;
}
.step.done,
.step.active {
  opacity: 1;
}
.dot {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #E8EBF0;
  color: #9AA1AD;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.step.done .dot {
  background: #2E9E5B;
  color: #fff;
}
.step.active .dot {
  background: #1E6FFF;
  color: #fff;
}
.step-info {
  display: flex;
  flex-direction: column;
}
.step-n {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1F2E;
}
.step-d {
  font-size: 22rpx;
  color: #9AA1AD;
  margin-top: 4rpx;
}

/* AI 思考中提示 */
.thinking {
  margin-top: 56rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}
.thinking-dots {
  display: flex;
  gap: 12rpx;
}
.tdot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #1E6FFF;
  animation: blink 1.2s infinite;
}
.tdot:nth-child(2) {
  animation-delay: 0.2s;
}
.tdot:nth-child(3) {
  animation-delay: 0.4s;
}
@keyframes blink {
  0%, 60%, 100% { opacity: 0.3; transform: scale(0.8); }
  30% { opacity: 1; transform: scale(1); }
}
.thinking-text {
  font-size: 24rpx;
  color: #1E6FFF;
}

/* ===== 流式生成区（AI 逐字写报告） ===== */
.streaming-box {
  width: 100%;
  margin-top: 48rpx;
  background: #F7F8FA;
  border: 1rpx solid #E8EBF0;
  border-radius: 20rpx;
  padding: 24rpx;
}
.streaming-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 16rpx;
}
.streaming-dots {
  display: flex;
  gap: 8rpx;
}
.streaming-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1E6FFF;
}
.streaming-scroll {
  max-height: 360rpx;
  width: 100%;
}
.streaming-text {
  font-size: 22rpx;
  color: #5B6372;
  line-height: 1.7;
  word-break: break-all;
  white-space: pre-wrap;
}
.streaming-text.placeholder {
  color: #9AA1AD;
  font-style: italic;
}

/* ===== 执行步骤明细（预置全量 → 灰/蓝/绿 三态） ===== */
.tool-steps {
  width: 100%;
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.tool-step {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  transition: background .25s, color .25s, border-color .25s;
  background: #F2F3F5;
  border: 1rpx solid #E8EBF0;
  color: #9AA1AD; /* pending 灰 */
}
.tool-step.running {
  background: rgba(30, 111, 255, 0.08);
  border-color: rgba(30, 111, 255, 0.3);
  color: #1E6FFF;
  animation: toolPulse 1.4s ease-in-out infinite;
}
@keyframes toolPulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(30, 111, 255, 0); }
  50% { box-shadow: 0 0 0 6rpx rgba(30, 111, 255, 0.06); }
}
.tool-step.done {
  background: rgba(46, 158, 91, 0.08);
  border-color: rgba(46, 158, 91, 0.18);
  color: #2E9E5B;
}
.tool-step-ic { flex-shrink: 0; width: 34rpx; text-align: center; }
.tool-step-text { flex: 1; line-height: 1.4; }
.tool-step-state {
  flex-shrink: 0;
  font-size: 20rpx;
  opacity: .85;
}

/* ===== AI 思考卡（reasoning 流可视化；低矮可滚，默认展开思考中，执行后收起为一行） ===== */
.think-card {
  width: 100%;
  margin: 10rpx 0 20rpx;
  background: #F7F8FA;
  border: 1rpx solid #E8EBF0;
  border-radius: 20rpx;
  overflow: hidden;
}
.think-hd {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 20rpx;
}
.think-ic { font-size: 26rpx; }
.think-t {
  flex: 1;
  font-size: 25rpx;
  font-weight: 600;
  color: #5B6372;
}
.think-state { font-size: 20rpx; color: #9AA1AD; }
.think-state.ing { color: #1E6FFF; }
.think-chev { color: #9AA1AD; font-size: 22rpx; transform: rotate(180deg); transition: transform .25s; }
.think-card.open .think-chev { transform: none; }
.think-bd { height: 0; overflow: hidden; transition: height .25s ease; }
.think-card.open .think-bd { height: 180rpx; }
.think-body { height: 100%; box-sizing: border-box; padding: 0 20rpx 16rpx; }
.think-text {
  font-size: 22rpx;
  color: #6B7280;
  line-height: 1.7;
  word-break: break-all;
  white-space: pre-wrap;
}

