<!-- 合同翻译官 - 对话追问页 -->
<view class="page">
  <!-- 顶部提示 -->
  <view class="chat-head">
    <text class="chat-head-text">基于本次合同上下文回答</text>
  </view>

  <!-- 消息列表 -->
  <view class="chat-box">
    <view wx:for="{{chatMessages}}" wx:key="index" class="chat-msg {{item.role}}">
      <view class="msg-avatar">{{item.role === 'ai' ? 'AI' : '我'}}</view>
      <view class="msg-bubble">{{item.text}}</view>
    </view>
    <view class="chat-msg ai" wx:if="{{sending}}">
      <view class="msg-avatar">AI</view>
      <view class="msg-bubble msg-thinking">
        <text>正在思考</text>
        <view class="thinking-dots">
          <view class="tdot"></view><view class="tdot"></view><view class="tdot"></view>
        </view>
      </view>
    </view>
  </view>
</view>

<!-- 底部输入栏（吸底：快捷问题 chips + textarea + 发送） -->
<view class="chat-input-bar">
  <!-- 快捷追问 chips（来自本次报告 askableQuestions，点一下即发送） -->
  <scroll-view
    wx:if="{{suggestions.length}}"
    class="chat-chips {{sending ? 'is-sending' : ''}}"
    scroll-x="{{true}}"
    enhanced
    show-scrollbar="{{false}}"
  >
    <view
      wx:for="{{suggestions}}"
      wx:key="*this"
      class="chip"
      data-q="{{item}}"
      bindtap="onTapChip"
    >{{item}}</view>
  </scroll-view>

  <view class="input-row">
    <textarea
      class="chat-input"
      placeholder="如：这个利率合法吗？提前还款会怎样？"
      placeholder-class="chat-input-ph"
      value="{{input}}"
      auto-height
      maxlength="200"
      cursor-spacing="20"
      fixed="{{true}}"
      show-confirm-bar="{{false}}"
      bindinput="onInput"
      disabled="{{sending}}"
    ></textarea>
    <button class="chat-send" bindtap="send" disabled="{{sending || !input}}">
      {{sending ? '…' : '发送'}}
    </button>
  </view>
</view>
