/* ===== 合同翻译官 - 对话追问页 ===== */
page {
  background: #F5F7FA;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F5F7FA;
  box-sizing: border-box;
  padding: 20rpx 32rpx;
  /* 底部吸底栏：chips + 一体化输入胶囊 + 安全区，留足空间（chips 收起时也至少留出输入框高度） */
  padding-bottom: calc(216rpx + env(safe-area-inset-bottom));
}

.chat-head {
  display: flex;
  justify-content: center;
  margin-bottom: 16rpx;
  flex-shrink: 0;
}
.chat-head-text {
  font-size: 22rpx;
  color: #9AA1AD;
}

/* 消息列表：占满 fixed 输入栏之上的剩余空间，内部自滚避免消息被遮 */
.chat-box {
  flex: 1 1 auto;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  padding-bottom: 24rpx;
  box-sizing: border-box;
}
.chat-msg {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
  align-items: flex-start;
}
.chat-msg:last-child {
  margin-bottom: 0;
}
.msg-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
  margin-top: 4rpx;
}
.chat-msg.ai .msg-avatar {
  background: #EAF2FF;
  color: #1E6FFF;
}
.chat-msg.user .msg-avatar {
  background: #1E6FFF;
  color: #fff;
}
.msg-bubble {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  font-size: 26rpx;
  color: #1A1F2E;
  line-height: 1.6;
  word-break: break-all;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.msg-text {
  font-size: 26rpx;
  color: inherit;
  line-height: 1.6;
  word-break: break-all;
}
/* 长 AI 消息：默认折叠为 5 行 + 展开更多；展开后显示全文 + 收起 */
.msg-bubble.collapsed .msg-text {
  display: -webkit-box;
  -webkit-line-clamp: 5;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}
.msg-expand {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #1E6FFF;
  text-align: right;
  line-height: 1.2;
}
.msg-expand:active { opacity: 0.7; }
.chat-msg.user .msg-bubble {
  background: #EAF2FF;
}
.msg-thinking {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #5B6372;
  font-size: 24rpx;
}
.thinking-dots {
  display: flex;
  gap: 6rpx;
}
.tdot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #1E6FFF;
  animation: blink 1.2s infinite;
}
.tdot:nth-child(2) {
  animation-delay: 0.2s;
}
.tdot:nth-child(3) {
  animation-delay: 0.4s;
}

/* ===== 底部吸底输入栏（一体化胶囊：背景透明，整条=一个白色圆角容器） ===== */
.chat-input-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding: 12rpx 24rpx calc(14rpx + env(safe-area-inset-bottom));
}

/* 快捷追问 chips（聚焦输入框时浮现，横向滚动胶囊） */
.chat-chips {
  flex-shrink: 0;
  white-space: nowrap;
  padding: 0 8rpx 14rpx;
}
.chip {
  display: inline-block;
  max-width: 420rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  vertical-align: middle;
  background: #EAF2FF;
  border: 1rpx solid #C9DFFF;
  color: #1E6FFF;
  font-size: 24rpx;
  line-height: 1.4;
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
  margin-right: 14rpx;
}
.chat-chips.is-sending .chip {
  opacity: 0.55;
}

/* 一体化输入胶囊：白底圆角容器内含透明输入框 + 右侧橙色小圆钮，视觉=一个整体 */
.chat-composer {
  display: flex;
  align-items: flex-end;
  gap: 14rpx;
  background: #fff;
  border: 2rpx solid #EEF0F4;
  border-radius: 48rpx;
  padding: 8rpx 10rpx 8rpx 32rpx;
  box-shadow: 0 6rpx 20rpx rgba(31, 36, 46, 0.05);
}
.chat-input {
  flex: 1;
  background: transparent;
  border: none;
  border-radius: 0;
  padding: 10rpx 0;
  font-size: 26rpx;
  color: #1A1F2E;
  line-height: 1.5;
  min-height: 72rpx;
  max-height: 180rpx;
  box-sizing: border-box;
  width: auto;
}
.chat-input-ph {
  color: #B7BDC9;
}
/* 小圆发送按钮：实心橙钮内嵌于胶囊右侧（未输入灰），视觉让位给输入区 */
.chat-send {
  flex: 0 0 76rpx;
  width: 76rpx;
  height: 76rpx;
  min-width: 76rpx;
  max-width: 76rpx;
  box-sizing: border-box;
  flex-shrink: 0;
  border-radius: 50%;
  background: #F97316;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  padding: 0;
  border: none;
  margin: 0;
  box-shadow: 0 4rpx 12rpx rgba(249, 115, 22, 0.28);
  transition: background 0.2s ease, box-shadow 0.2s ease;
}
.chat-send::after {
  border: none;
}
.chat-send[disabled] {
  background: #E8EAED;
  color: #C3C8D0;
  box-shadow: none;
}
