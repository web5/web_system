<!-- 合同翻译官 - 上传页 -->
<view class="page">
  <!-- 场景选择 -->
  <view class="scene-row">
    <view class="scene-pill {{scene === '' ? 'active' : ''}}" data-scene="" bindtap="onSceneChange">自动识别</view>
    <view class="scene-pill {{scene === 'consumer-loan' ? 'active' : ''}}" data-scene="consumer-loan" bindtap="onSceneChange">消费贷</view>
    <view class="scene-pill {{scene === 'car-loan' ? 'active' : ''}}" data-scene="car-loan" bindtap="onSceneChange">购车</view>
    <view class="scene-pill {{scene === 'medical-insurance' ? 'active' : ''}}" data-scene="medical-insurance" bindtap="onSceneChange">保险</view>
  </view>

  <!-- 上传区 -->
  <view class="upload-options">
    <view class="upload-opt">
      <image class="opt-ic" src="data:image/svg+xml;base64," mode="aspectFit" />
      <text class="opt-n">拍照识别</text>
      <text class="opt-d">拍摄合同页面</text>
    </view>
    <view class="upload-opt">
      <image class="opt-ic" src="data:image/svg+xml;base64," mode="aspectFit" />
      <text class="opt-n">相册</text>
      <text class="opt-d">选择已有图片</text>
    </view>
    <view class="upload-opt">
      <image class="opt-ic" src="data:image/svg+xml;base64," mode="aspectFit" />
      <text class="opt-n">文件</text>
      <text class="opt-d">PDF / 图片</text>
    </view>
  </view>

  <!-- 文本粘贴（MVP：OCR 未接前先用文本） -->
  <view class="text-section">
    <view class="text-head">
      <text class="text-title">或粘贴合同文字</text>
      <text class="text-tip">OCR 功能开发中</text>
    </view>
    <textarea
      class="contract-textarea"
      placeholder="粘贴合同条款内容，如借款金额、利率、费用、违约金等..."
      value="{{contractText}}"
      bindinput="onInput"
      maxlength="8000"
    ></textarea>
  </view>

  <!-- 示例样本 -->
  <view class="sample-card">
    <text class="sample-title">没有合同？用示例体验</text>
    <view class="sample-item" data-key="loan" bindtap="useSample">
      <text class="sample-n">示例：消费贷款合同</text>
      <text class="sample-go">使用 ›</text>
    </view>
    <view class="sample-item" data-key="insurance" bindtap="useSample">
      <text class="sample-n">示例：医疗保险条款</text>
      <text class="sample-go">使用 ›</text>
    </view>
  </view>

  <button class="analyze-btn" bindtap="startAnalyze" disabled="{{analyzing}}">
    {{analyzing ? '分析中...' : '开始体检合同'}}
  </button>

  <view class="privacy-note">文件加密存储 · 数据仅用于本次解读 · 可随时删除 · 不用于模型训练</view>
</view>
