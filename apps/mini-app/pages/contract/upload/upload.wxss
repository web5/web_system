/* ===== 合同翻译官 - 上传页 ===== */
/* 显式覆盖 app.wxss 的全局黑色 page 背景，避免重编译瞬间黑屏 */
page {
  background: #F5F7FA;
}

.page {
  min-height: 100vh;
  background: #F5F7FA;
  padding: 24rpx 32rpx 60rpx;
}

/* 场景选择 */
.scene-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.scene-pill {
  padding: 14rpx 28rpx;
  border-radius: 32rpx;
  background: #fff;
  color: #5B6372;
  font-size: 26rpx;
  border: 1rpx solid #E8EBF0;
}
.scene-pill.active {
  background: #1E6FFF;
  color: #fff;
  border-color: #1E6FFF;
}

/* 上传选项 */
.upload-options {
  display: flex;
  gap: 20rpx;
  margin-bottom: 28rpx;
}
.upload-opt {
  flex: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 2rpx solid transparent;
}
.upload-opt:active {
  border-color: #1E6FFF;
}
.opt-ic {
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 12rpx;
}
.opt-n {
  font-size: 26rpx;
  font-weight: 600;
  color: #1A1F2E;
}
.opt-d {
  font-size: 22rpx;
  color: #9AA1AD;
  margin-top: 6rpx;
}

/* 文本粘贴 */
.text-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 28rpx;
}
.text-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.text-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1F2E;
}
.text-tip {
  font-size: 22rpx;
  color: #9AA1AD;
}
.contract-textarea {
  width: 100%;
  height: 240rpx;
  background: #F7F8FA;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 26rpx;
  color: #1A1F2E;
  box-sizing: border-box;
}

/* 示例样本 */
.sample-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 40rpx;
}
.sample-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1F2E;
  display: block;
  margin-bottom: 16rpx;
}
.sample-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 8rpx;
  border-bottom: 1rpx solid #E8EBF0;
}
.sample-item:last-child {
  border-bottom: none;
}
.sample-n {
  font-size: 26rpx;
  color: #1A1F2E;
}
.sample-go {
  font-size: 24rpx;
  color: #1E6FFF;
}

/* 分析按钮 */
.analyze-btn {
  background: #1E6FFF;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 40rpx;
  padding: 24rpx 0;
  border: none;
}
.analyze-btn::after {
  border: none;
}
.analyze-btn[disabled] {
  background: #9DBFFF;
  color: #fff;
}

/* 隐私说明 */
.privacy-note {
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: #9AA1AD;
  line-height: 1.6;
}
