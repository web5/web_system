/* 合同翻译官 - 首页（按 v5 原型稿还原） */
page {
  background: #F5F7FA;
}
.page {
  padding-bottom: 40rpx;
}

/* ===== 品牌区：渐变 hero ===== */
.home-hero {
  background: linear-gradient(135deg, #1E6FFF 0%, #2E8BFF 100%);
  color: #fff;
  padding: 48rpx 40rpx 88rpx;
}
.home-logo {
  font-size: 26rpx;
  opacity: 0.92;
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.home-title {
  font-size: 50rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
  line-height: 1.25;
}
.home-desc {
  font-size: 25rpx;
  line-height: 1.6;
  opacity: 0.92;
}

/* ===== 双入口卡（上叠到 hero） ===== */
.entry-cards {
  padding: 0 32rpx;
  margin-top: -48rpx;
  position: relative;
}
.entry {
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(20, 30, 50, 0.06);
  border: 1rpx solid #E8EBF0;
  padding: 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  gap: 24rpx;
  align-items: center;
}
.entry-hover {
  transform: scale(0.99);
  opacity: 0.95;
}
.entry .e-ic {
  width: 92rpx;
  height: 92rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex-shrink: 0;
}
.entry.cam .e-ic { background: #EAF2FF; }
.entry.chat .e-ic { background: linear-gradient(135deg, #E7F5EC 0%, #DDF1E5 100%); }
.entry .e-main { flex: 1; }
.entry .e-t {
  display: block;
  font-size: 31rpx;
  font-weight: 700;
  color: #1A1F2E;
}
.entry .e-d {
  display: block;
  font-size: 23rpx;
  color: #9AA1AD;
  margin-top: 6rpx;
  line-height: 1.5;
}
.entry .e-go {
  font-size: 44rpx;
  color: #9AA1AD;
}

/* ===== 能查什么 ===== */
.sec-head {
  padding: 20rpx 32rpx 14rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1F2E;
}
.scene-grid {
  padding: 8rpx 32rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.scene-item {
  width: calc(50% - 12rpx);
  background: #fff;
  border: 1rpx solid #E8EBF0;
  border-radius: 24rpx;
  padding: 24rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
}
.scene-item .si {
  width: 60rpx;
  height: 60rpx;
  border-radius: 16rpx;
  background: #EAF2FF;
  color: #1E6FFF;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}
.scene-item .n {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #1A1F2E;
}
.scene-item .d {
  display: block;
  font-size: 21rpx;
  color: #9AA1AD;
  margin-top: 4rpx;
  line-height: 1.4;
}

/* ===== 免责声明 ===== */
.disclaimer-tip {
  margin: 16rpx 32rpx;
  background: #FFF3E6;
  border: 1rpx solid #FFD9B8;
  border-radius: 20rpx;
  padding: 24rpx;
  font-size: 22rpx;
  color: #B2592A;
  line-height: 1.6;
}
