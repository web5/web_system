/* ===== 合同翻译官 - 首页 ===== */
.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #EAF2FF 0%, #F5F7FA 30%);
  padding-bottom: 60rpx;
}

/* 品牌区 */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 40rpx 56rpx;
  background: linear-gradient(135deg, #1E6FFF 0%, #2E8BFF 100%);
  border-radius: 0 0 32rpx 32rpx;
}
.hero-shield {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}
.hero-shield-ic {
  font-size: 48rpx;
  color: #fff;
}
.hero-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 2rpx;
}
.hero-slogan {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
}
.hero-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.5;
  text-align: center;
}

/* 上传卡片 */
.upload-card {
  margin: -40rpx 32rpx 0;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8rpx 32rpx rgba(30, 111, 255, 0.12);
}
.upload-icon {
  width: 72rpx;
  height: 72rpx;
  margin-bottom: 16rpx;
}
.upload-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1F2E;
}
.upload-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9AA1AD;
}
.upload-badges {
  margin-top: 20rpx;
  display: flex;
  gap: 16rpx;
}
.badge {
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  background: #EAF2FF;
  color: #1E6FFF;
}

/* 场景区 */
.section {
  margin: 40rpx 32rpx 0;
}
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1F2E;
  display: block;
  margin-bottom: 20rpx;
}
.scene-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}
.scene-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.scene-ic {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  background: #EAF2FF;
  color: #1E6FFF;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}
.scene-n {
  font-size: 26rpx;
  font-weight: 600;
  color: #1A1F2E;
  display: block;
}
.scene-d {
  font-size: 22rpx;
  color: #9AA1AD;
  margin-top: 4rpx;
  display: block;
  line-height: 1.4;
}

/* 免责声明 */
.disclaimer {
  margin: 40rpx 32rpx 0;
  background: #FFF3E6;
  border: 1rpx solid #FFD9B8;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}
.disclaimer-text {
  font-size: 22rpx;
  color: #B2592A;
  line-height: 1.6;
}
