{
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "dotenv": "^17.4.2",
    "sharp": "^0.35.3"
  },
  "scripts": {
    "build:cdn": "node scripts/build-externals.mjs && node scripts/build-public-assets.mjs",
    "build:public-assets": "node scripts/build-public-assets.mjs",
    "pub:dev": "bash scripts/publish.sh dev",
    "pub:prod": "bash scripts/publish.sh prod",
    "pub:local": "bash scripts/deploy-local.sh",
    "check:env": "bash scripts/check-env.sh",
    "check:health": "bash scripts/health-check.sh",
    "sync:schema": "bash scripts/sync-schema.sh",
    "lint": "eslint apps/shell apps/portal apps/admin apps/deploy-console packages/ui",
    "lint:ci": "eslint apps/shell apps/portal apps/admin apps/deploy-console packages/ui --max-warnings 328",
    "test:verify": "bash scripts/verify/verify-deploy-console.sh --quick",
    "test:chain": "bash scripts/verify/verify-business-chain.sh local",
    "test:e2e:list": "playwright test --config tests/playwright.config.ts --list",
    "test:e2e": "playwright test --config tests/playwright.config.ts"
  }
}