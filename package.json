{
  "devDependencies": {
    "dotenv": "^17.4.2",
    "sharp": "^0.35.3"
  },
  "scripts": {
    "pub:dev": "bash scripts/publish.sh dev",
    "pub:prod": "bash scripts/publish.sh prod",
    "pub:local": "bash scripts/deploy-local.sh",
    "check:env": "bash scripts/check-env.sh",
    "check:health": "bash scripts/health-check.sh",
    "sync:schema": "bash scripts/sync-schema.sh",
    "sync:kit": "bash scripts/sync-agent-kit.sh",
    "kit:check": "bash scripts/redline/check-kit-structure.sh",
    "redline:local": "bash scripts/redline/check-commit.sh",
    "redline:scan": "bash scripts/redline/scan-rules.sh cached",
    "redline:tree": "bash scripts/redline/scan-rules.sh tree",
    "hooks:install": "bash scripts/redline/install-git-hooks.sh",
    "hooks:status": "bash scripts/redline/install-git-hooks.sh -d"
  }
