# ============================================
# 生产环境配置模板
# 部署时复制为 .env.production 并填写实际值
# cp .env.production.example .env.production
# ============================================

# --- 数据库（腾讯云 CDB MySQL 内网地址）---
DB_TYPE=mysql
DB_HOST=172.16.16.10
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_db_password_here
DB_DATABASE=web_system

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379

# --- JWT ---
JWT_SECRET=your-jwt-secret-change-this-in-production
JWT_EXPIRES_IN=7d

# --- Gateway（端口 600x，2026-08 起）---
PORT=6000
HOST=0.0.0.0
AUTH_SERVICE_URL=http://127.0.0.1:6001
USER_SERVICE_URL=http://127.0.0.1:6002
AI_SERVICE_URL=http://127.0.0.1:6003
SYSTEM_SERVICE_URL=http://127.0.0.1:6004
TODO_SERVICE_URL=http://127.0.0.1:6005
MCP_GATEWAY_URL=http://127.0.0.1:6006
FINNEWS_SERVICE_URL=http://127.0.0.1:6007
UPLOAD_SERVICE_URL=http://127.0.0.1:6008
PUBLIC_URL=http://106.52.176.246:6000
CORS_ORIGINS=*

# --- 服务间鉴权（mcp-gateway → gateway 调 /api/finnews 时必须带此 Bearer）---
FINNEWS_SERVICE_KEY=your-finnews-service-key-here

# --- MCP 客户端鉴权（WorkBuddy 连 /mcp 时带的 Bearer key）---
MCP_CLIENT_KEY=your-mcp-client-key-here
