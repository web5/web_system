# ==========================================
# Web System - 部署脚本环境变量模板
# 复制此文件为 .env 并填写真实值
# 此文件与部署脚本一起放在 scripts/ 目录
# ==========================================

# 跳板机（Gateway/Nginx 所在服务器）
JUMP_HOST=root@your-jump-host
JUMP_PASSWORD=your-jump-password

# 后端服务器（微服务所在）
MICRO_HOST=root@your-micro-host
MICRO_PASSWORD=your-micro-password

# 部署服务器（deploy.sh 使用）
DEPLOY_HOST=ubuntu@your-deploy-host
DEPLOY_DIR=/home/ubuntu/web_system
