# ===========================================================
# 部署环境配置文件
# 复制此文件为 .env.deploy，填入实际服务器信息
# ===========================================================
# 注意：此文件包含服务器密码，不要提交到 Git！
# 已在 .gitignore 中忽略 .env.deploy
# ===========================================================

# ---- 开发环境 ----
DEV_SERVER="ubuntu@{{DEV_HOST}}"
DEV_REMOTE_DIR="/data/web_system"
DEV_PUBLIC_URL="https://dev.example.com"

# ---- 生产环境 ----
PROD_SERVER="root@{{PROD_HOST}}"
PROD_REMOTE_DIR="/data/web_system"
PROD_PUBLIC_URL="https://portal.example.com"

# ---- 网关/跳板机 ----
JUMP_HOST="root@{{GATEWAY_HOST}}"
GATEWAY_SERVER="{{GATEWAY_HOST}}"

# ---- 堡垒机 / 发布控制台机（deploy-console 落地机）----
# 定位：发布执行的**固定来源 IP**；dev/prod 的安全组、authorized_keys 以及
#       云数据库公网白名单，都只需放行这一个地址。
# 密钥：无口令专用部署密钥（按环境/用途拆分，不要与其它机器共用）
LIGHTHOUSE_SERVER="{{LIGHTHOUSE_HOST}}"
LIGHTHOUSE_USER=ubuntu
LIGHTHOUSE_KEY="~/.ssh/id_ed25519_lighthouse"
LIGHTHOUSE_REMOTE_DIR="/data/web_system"
# LIGHTHOUSE_PUBLIC_URL="https://console.example.com"   # 控制台对外地址（nginx 反代后再填）

# ---- 通用配置 ----
# 本地项目根目录（自动获取，一般无需修改）
# PROJECT_DIR="$(cd "$(dirname "$0")/.." && pwd)"

# ---- 数据库连接（sync-schema.sh / seed.sh 读取，禁止硬编码到脚本）----
# dev 库：经跳板连目标服务器本地 MySQL
DEV_DB_HOST=127.0.0.1
DEV_DB_PORT=3306
DEV_DB_USER=root
DEV_DB_PASS="{{DEV_DB_PASSWORD}}"

# prod 库：经跳板连内网 DB 主机
PROD_DB_HOST="{{PROD_DB_HOST}}"
PROD_DB_PORT=3306
PROD_DB_USER=root
PROD_DB_PASS="{{PROD_DB_PASSWORD}}"
