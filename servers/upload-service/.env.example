PORT=6008
UPLOAD_DIR=uploads

# 服务间调用 system-service 内部接口的地址（拉取公网根地址等）。默认 127.0.0.1:6004。
SYSTEM_SERVICE_URL=http://127.0.0.1:6004
# 服务间调用 system-service 内部接口的共享密钥（与 system-service 的 INTERNAL_API_KEY 一致）。
INTERNAL_API_KEY=

# 公网访问基座：现在只是「DB 未配时的 env 兜底」。
# 主源为 system-service 的 system_configs 表 key=public_base_url（经内部接口拉取）。
PUBLIC_BASE_URL=
