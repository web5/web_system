# 服务端口
PORT=6200

# 配置文件目录
ENV_CONFIG_DIR=/data/env_config

# Web 系统目录
WEB_SYSTEM_DIR=/data/web_system

# 管理员凭据（IAM 一期起仅作**应急逃生通道**：CONSOLE_ALLOW_LEGACY_LOGIN=1 时才生效）
# 正常登录已代理给 auth-service（见下方 AUTH_SERVICE_URL），口令不再由本服务持有
ADMIN_USER=admin
ADMIN_PASS={{ADMIN_PASSWORD}}
CONSOLE_ALLOW_LEGACY_LOGIN=0

# 认证服务（登录代理目标；system=deploy，只有归属运维系统的账号能通过）
AUTH_SERVICE_URL=http://127.0.0.1:6101

# JWT 密钥：**必须与 auth-service / gateway 同源**（校验统一签发的令牌）。
# 缺失本服务启动即失败 —— 不再使用内置默认密钥。
JWT_SECRET={{JWT_SECRET}}

# 开发环境服务器
DEV_SERVER={{DEV_HOST}}
DEV_USER={{SSH_USER}}
DEV_KEY={{SSH_KEY_PATH}}

# 生产环境服务器
PROD_SERVER={{PROD_HOST}}
PROD_USER={{SSH_USER}}

# 网关服务器
GATEWAY_SERVER={{GATEWAY_HOST}}
GATEWAY_USER={{SSH_USER}}

# 审计日志路径
AUDIT_LOG_PATH=/data/env_config/deploy-audit.log

# ===== 发布流水线 / MCP =====
# MCP 每用户 API Key 校验（调 user-service 内部接口 /internal/keys/verify）
USER_SERVICE_URL=http://127.0.0.1:6002
# 内部服务间密钥（必须与 user-service 的 INTERNAL_API_KEY 一致，生产用环境变量注入）
INTERNAL_API_KEY=
# gateway 内网地址（流水线验证阶段查询 __manifest__ 用）
GATEWAY_INTERNAL_URL=http://localhost:6000
# 流水线默认投递目标：local=本机静态目录；remote=SSH 到远程服务器
PIPELINE_UPLOAD_TARGET=local
# 发布成功后自动同步权限点（调 user-service /internal/permissions/sync，幂等；失败不阻断发布）
# 设为 false 可关闭：代码声明在共享包 packages/types，任何一次发布都可能带新权限码，
# 不自动同步就会出现"接口调得通、前端菜单不出现"（需人工点「同步权限点」或重启 user-service）
PIPELINE_PERM_SYNC=true
# 节点模型开关（终态 = shell / approval 两类节点；写版本/切指针已变成节点里的 service 操作）
# 2026-09-15 起**缺省即为 on**：只有显式写 off/false/0/no 才回退 legacy
# （legacy = 新建流水线时 nodes 落 null，流程画布空白、只能靠 steps 兜底）。
# 这里显式写出，便于环境自查。
PIPELINE_V5_NODES=on

# 配置中心主密钥（AES-256-GCM，32 字节）。两种方式，优先文件：
# 方式一（推荐）：值放 0600 文件，这里只写路径（值不进进程 env、不进 git、不进 ps）
#   默认路径 /etc/web-system/config-master.key；本地演练可用 ~/.config/web-system/config-master.key
#   生成：openssl rand -base64 32 > <路径> && chmod 600 <路径>
CONFIG_MASTER_KEY_FILE=
# 方式二（过渡/本地）：直接给值。与文件同时存在时必须一致，否则启动即报错（防错配）
# 生成：openssl rand -base64 32
# 切勿把真实值提交到代码库
CONFIG_MASTER_KEY=

# ===== 按环境分流：prod 数据写云数据库（specs/deploy-console-env-datasource/design.md） =====
# 背景：console 在 dev 机（南京 vpc-ljskd1kp），云数据库在广州 vpc-hiltvaat，
# dev → 云库内网跨地域+跨 VPC 不通，只能走公网；而 prod gateway 内网读云库。
# 不开这个开关 = prod 指针靠人工同步（2026-09-30 基座事故的成因）。
# 总开关：false 即回到人工同步现状（秒级回退，无数据破坏）
DEPLOY_CLOUD_DB_ENABLED=false
# 云数据库**公网**地址（控制台「外网地址/外网端口」；白名单须放行本机公网 IP，建议绑 EIP）
DEPLOY_CLOUD_DB_HOST=
DEPLOY_CLOUD_DB_PORT=
DEPLOY_CLOUD_DB_USER=
DEPLOY_CLOUD_DB_PASSWORD=
DEPLOY_CLOUD_DB_NAME=web_system_deploy
# 严格模式：prod 指针写云库失败时**让发布任务失败**（默认 true）。
# ⚠️ 单库时代「失败只告警」是止损；分流后是事故放大器：
# 本地成功 + 云库失败 = 流水线显示成功、prod 实际没切版本。故默认严格，
# 仅在应急窗口显式置 false（退回告警语义）。
DEPLOY_CLOUD_DB_STRICT=true

# CI/CD 发布触发端点密钥（POST /api/hooks/release 的 HMAC-SHA256 签名密钥）
# 生成：openssl rand -hex 32
# 需与 GitHub Actions Secrets 的 RELEASE_HOOK_SECRET 保持一致。
# 未配置时触发端点直接拒绝所有请求（拒绝而非放行，避免未鉴权暴露）。
# 切勿把真实值提交到代码库
RELEASE_HOOK_SECRET=
