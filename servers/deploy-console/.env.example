# 服务端口
PORT=6200

# 配置文件目录
ENV_CONFIG_DIR=/data/env_config

# Web 系统目录
WEB_SYSTEM_DIR=/data/web_system

# 管理员凭据
ADMIN_USER=admin
ADMIN_PASS=deploy2026

# JWT 密钥
JWT_SECRET=deploy-console-secret-key-change-in-production

# 开发环境服务器
DEV_SERVER=175.27.189.123
DEV_USER=ubuntu
DEV_KEY=~/.ssh/id_ed25519_servers

# 生产环境服务器
PROD_SERVER=106.52.176.246
PROD_USER=root

# 网关服务器
GATEWAY_SERVER=42.194.200.69
GATEWAY_USER=root

# 审计日志路径
AUDIT_LOG_PATH=/data/env_config/deploy-audit.log

# ===== 发布流水线 / MCP =====
# MCP 每用户 API Key 校验（调 user-service 内部接口 /internal/keys/verify）
USER_SERVICE_URL=http://127.0.0.1:6002
# 内部服务间密钥（必须与 user-service 的 INTERNAL_API_KEY 一致，生产用环境变量注入）
INTERNAL_API_KEY=
# gateway 内网地址（流水线验证阶段查询 __manifest__ 用）
GATEWAY_INTERNAL_URL=http://localhost:6000
# 流水线默认投递目标：local=本机静态目录；remote=SSH 到远程服务器
PIPELINE_UPLOAD_TARGET=local

# 配置中心主密钥（AES-256-GCM，32 字节）
# 生成：openssl rand -base64 32
# 切勿把真实值提交到代码库
CONFIG_MASTER_KEY=
