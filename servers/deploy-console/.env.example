# 服务端口
PORT=6200

# 配置文件目录
ENV_CONFIG_DIR=/data/env_config

# Web 系统目录
WEB_SYSTEM_DIR=/data/web_system

# 管理员凭据
ADMIN_USER=admin
ADMIN_PASS=<CONSOLE_ADMIN_PASSWORD>

# JWT 密钥
JWT_SECRET=deploy-console-secret-key-change-in-production

# 开发环境服务器
DEV_SERVER=203.0.113.10
DEV_USER=ubuntu
DEV_KEY=~/.ssh/id_ed25519_servers

# 生产环境服务器
PROD_SERVER=198.51.100.20
PROD_USER=root

# 网关服务器
GATEWAY_SERVER=192.0.2.30
GATEWAY_USER=root

# 审计日志路径
AUDIT_LOG_PATH=/data/env_config/deploy-audit.log
