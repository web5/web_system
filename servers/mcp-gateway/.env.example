# MCP Gateway 环境变量（复制为 .env 后填写）
# 数据库（本地 MySQL / 生产 PostgreSQL）
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=web_system

# 服务端口
PORT=6006

# CORS（mcp-admin 界面地址）
CORS_ORIGINS=http://localhost:5175

# 环境
NODE_ENV=development

# 财经资讯微服务地址（自动 seed 到 mcp_modules）
# 两种模式：① 直连 http://localhost:6007；② 走 gateway 代理 http://localhost:6000/api/finnews
FINNEWS_SERVICE_URL=http://localhost:6007

# 服务间鉴权（仅当 FINNEWS_SERVICE_URL 指向 gateway 代理时生效）
FINNEWS_SERVICE_AUTH_TYPE=bearer
FINNEWS_SERVICE_AUTH_CONFIG={"token":"your-finnews-service-key-here"}

# MCP 客户端鉴权（WorkBuddy 连 /mcp 时带的 Bearer key；留空则跳过鉴权）
MCP_CLIENT_KEY=your-mcp-client-key-here
