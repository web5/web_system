# MCP Gateway 环境变量（复制为 .env 后填写）
# 数据库（本地 MySQL / 生产 PostgreSQL）
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=web_system

# 服务端口
PORT=6006

# CORS（mcp-admin 界面地址）
CORS_ORIGINS=http://localhost:5175

# 环境
NODE_ENV=development

# 财经资讯微服务地址（自动 seed 到 mcp_modules）
# 两种模式：① 直连 http://localhost:6007；② 走 gateway 代理 http://localhost:6000/api/finnews
FINNEWS_SERVICE_URL=http://localhost:6007

# 服务间鉴权（仅当 FINNEWS_SERVICE_URL 指向 gateway 代理时生效）
FINNEWS_SERVICE_AUTH_TYPE=bearer
FINNEWS_SERVICE_AUTH_CONFIG={"token":"your-finnews-service-key-here"}

# 内容中枢地址（自动 seed 公众号发布模块 wechat_mp 到 mcp_modules）
# 两种模式：① 直连 http://localhost:6007；② 走 gateway 代理 http://localhost:6000/api/content-hub
CONTENT_HUB_SERVICE_URL=http://localhost:6007

# 服务间鉴权（仅当 CONTENT_HUB_SERVICE_URL 指向 gateway 代理时生效，与 FINNEWS 共用 service key）
CONTENT_HUB_SERVICE_AUTH_TYPE=bearer
CONTENT_HUB_SERVICE_AUTH_CONFIG={"token":"your-finnews-service-key-here"}

# MCP 客户端鉴权（WorkBuddy 连 /mcp 时带的 Bearer key；保留作为遗留兼容）
MCP_CLIENT_KEY=your-mcp-client-key-here

# 运营后台密钥（保护 /api/keys 列表/吊销接口，请求头 X-Admin-Key）
MCP_ADMIN_KEY=your-admin-key-here

# 申请验证码邮件 SMTP（留空则 /api/keys/apply 返回 503）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
