# AI Service 环境变量模板

# Hy3 API 配置（腾讯混元 Turbo，通过 Tencent MaaS TokenHub 接入）
HY3_API_KEY=your_api_key_here
# baseUrl 可填到 /v1 或到完整 /v1/chat/completions，代码会自动归一化
HY3_BASE_URL=https://tokenhub.tencentmaas.com/v1

# 服务器配置
PORT=6003
NODE_ENV=development

# 数据库配置（MySQL）
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_password
DB_DATABASE=web_system

# Redis 配置（可选）
REDIS_HOST=localhost
REDIS_PORT=6379

# 腾讯云 TTS 语音合成（用于英语学习发音播放）
# 开通地址：https://console.cloud.tencent.com/tts
TENCENT_SECRET_ID=your_secret_id_here
TENCENT_SECRET_KEY=your_secret_key_here
