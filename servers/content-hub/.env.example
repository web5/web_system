# 数据库（和 web_system 大仓共用）
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=web_system

# 服务端口
PORT=6007

# CORS
CORS_ORIGINS=http://localhost:5175

# 微信公众号发布凭据（认证服务号 AppID/AppSecret，用于草稿箱 + freepublish 发布）
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=

# 环境
NODE_ENV=development

# 统一上传服务（封面素材唯一落盘入口）
UPLOAD_SERVICE_URL=http://localhost:6008
# 服务间鉴权：与 upload-service 的 INTERNAL_API_KEY 保持一致
INTERNAL_API_KEY=

# 封面「按标题生成」：腾讯云 MaaS 文生图（留空则该功能不可用，手动上传不受影响）
IMAGE_GEN_API_URL=https://tokenhub.tencentmaas.com
IMAGE_GEN_API_KEY=

