# Knowledge Service 环境变量（复制为 .env 后填写）
# 数据库（独立知识库，需先 CREATE DATABASE web_system_knowledge）
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=web_system_knowledge

# 服务端口
PORT=6011

# CORS
CORS_ORIGINS=http://localhost:5175

# 环境
NODE_ENV=development

# 认证服务（admin 接口 JWT 校验：经 gateway 转发后在此验签）
AUTH_SERVICE_URL=http://localhost:6001

# 内部调用密钥（mcp-gateway seed 的 knowledge 模块 Bearer token 与此同值；
# admin/UI 走 JWT，MCP 工具调用走此 key）
INTERNAL_API_KEY=your-internal-key-here

# embedding（tokenhub OpenAI 兼容 /embeddings；回落 HY3_* / LLM_*）
TOKENHUB_BASE_URL=https://tokenhub.tencentmaas.com/v1
TOKENHUB_API_KEY=
EMBEDDING_MODEL=bge-m3
