# AI Agent 服务环境变量模板

# 模型客户端（与 ai-service 一致的接入方式）
HY3_API_KEY=your_api_key_here
HY3_BASE_URL=https://tokenhub.tencentmaas.com/v1
DEEPSEEK_API_KEY=your_deepseek_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 腾讯云 OCR（合同图片识别，与 ai-service TTS 共用密钥）
TENCENT_SECRET_ID=your_secret_id_here
TENCENT_SECRET_KEY=your_secret_key_here

# 服务器配置
PORT=6010
NODE_ENV=development

# 认证服务（JWT 校验）
AUTH_SERVICE_URL=http://localhost:6001

# AI Service URL（推送 agent run 记录到 ai-service 统一落库，admin 调试用）
AI_SERVICE_URL=http://localhost:6003

# CORS 白名单（具体域名，禁止 *)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# 数据库（持久化 Agent 对话记忆，支持多轮追问）
# DB_TYPE 支持 postgres / mysql / sqlite
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=web_system
DB_PASSWORD=your_password
DB_DATABASE=web_system
