# AI Agent 服务环境变量模板

# ===== LLM 唯一通道：TokenHub 网关（OpenAI 兼容）=====
# 企业版 base：https://tokenhub.tencentmaas.com/v1（开通后付费后可后端调用）
# 个人 plan base：https://api.lkeap.cloud.tencent.com/plan/v3（有 4000 输出 cap，且禁后端直调）
# 模型（deepseek/hy4/glm/kimi/minimax 等）以 Agent 定义 DB 的 model 字段为准（对应网关上 id）

# 网关 API Key（必填；企业版与个人 plan 各自独立 key）
TOKENHUB_API_KEY=sk-tp-xxxx
# 网关 Base URL（OpenAI 兼容；注释掉则回落默认 https://tokenhub.tencentmaas.com/v1）
TOKENHUB_BASE_URL=https://tokenhub.tencentmaas.com/v1
# 注册进 clientRegistry 的模型 id 列表（逗号分隔，Agent DB model 必须能匹配其中一项）
# GET {BASE_URL}/models 可列网关上全部 id
TOKENHUB_MODELS=deepseek/deepseek-v4-pro,deepseek/deepseek-v4-flash,deepseek-v4-pro-0813,hy4-preview,glm-5.3,kimi-k3,qwen3.5-plus,minimax-m3

# DeepSeek 系为推理模型：stream=true 时网关会忽略 reasoning_effort，推理 token 挤满输出预算
# 导致正文为 0（长报告截断成空）。注意：流式下网关会忽略 reasoning_effort，
# 但透传官方 `thinking` 参数，用 thinking 限制"思考预算"即可保证正文完整：
#   TOKENHUB_THINKING=none          关闭思考（纯正文，最快）
#   TOKENHUB_THINKING=budget:1024   思考限 1024 token，正文保底（推荐，保留"边思考边答"）
#   留空 = 仅 DeepSeek 推理系默认 budget:1024，其余模型不限制
# 若确需"整段一次性返回"，可设 TOKENHUB_STREAM=false（默认 true 真流式）
# TOKENHUB_THINKING=budget:1024

# 单次最大输出 token（默认 8000；网关/套餐可能有更小硬 cap）
# TOKENHUB_MAX_TOKENS=8000

# 腾讯云 OCR（合同图片识别，与 ai-service TTS 共用密钥）
TENCENT_SECRET_ID=your_secret_id_here
TENCENT_SECRET_KEY=your_secret_key_here

# 服务器配置
PORT=6010
NODE_ENV=development

# 认证服务（JWT 校验）
AUTH_SERVICE_URL=http://localhost:6001

# AI Service URL（推送 agent run 记录到 ai-service 统一落库，admin 调试用）
AI_SERVICE_URL=http://localhost:6003

# System Service URL（拉取字典 llm_models 用；服务间接口需 x-internal-key）
SYSTEM_SERVICE_URL=http://127.0.0.1:6004
# 模型清单来源：db（默认，读字典）| env（只看 TOKENHUB_MODELS）| builtin（只用代码内置）
MODEL_SOURCE=db
# 字典编码与轮询间隔（毫秒）
MODEL_DICT_CODE=llm_models
MODEL_POLL_MS=60000

# 内部服务鉴权（PermissionGuard 调 user-service /internal/roles/permissions 用，须与 user-service 一致）
INTERNAL_API_KEY=your_internal_api_key_here
USER_SERVICE_URL=http://127.0.0.1:6002

# MCP 网关（远程工具懒加载接入；MCP_CLIENT_KEY 须与 mcp-gateway 一致）
MCP_GATEWAY_URL=http://127.0.0.1:6006
MCP_CLIENT_KEY=your-mcp-client-key-here

# CORS 白名单（具体域名，禁止 *)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# 数据库（持久化 Agent 对话记忆，支持多轮追问）
# DB_TYPE 支持 postgres / mysql / sqlite
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=web_system
DB_PASSWORD=your_password
DB_DATABASE=web_system
