# 服务端口
PORT=6000

# JWT 配置
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# CORS 配置 (多个用逗号分隔)
CORS_ORIGINS=https://dev.kedouai.com

# 后端微服务地址
AUTH_SERVICE_URL=http://localhost:6001
USER_SERVICE_URL=http://localhost:6002
AI_SERVICE_URL=http://localhost:6003
SYSTEM_SERVICE_URL=http://localhost:6004
TODO_SERVICE_URL=http://localhost:6005
UPLOAD_SERVICE_URL=http://localhost:6008
MCP_GATEWAY_URL=http://localhost:6006

# 财经资讯微服务（/api/finnews 代理目标 + 服务间鉴权密钥）
FINNEWS_SERVICE_URL=http://localhost:6007
FINNEWS_SERVICE_KEY=your-finnews-service-key-here

# 静态资源目录
STATIC_ROOT=./public

# 日志级别
LOG_LEVEL=info
