# 服务端口
PORT=3001

# 环境
NODE_ENV=development

# JWT 配置
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# CORS 配置 (多个用逗号分隔)
CORS_ORIGINS=https://dev.kedouai.com

# 数据库配置
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_password
DB_DATABASE=web_system

# Redis 配置
REDIS_URL=redis://localhost:6379

# ===== 小程序配置（wx.login → jscode2session）=====
MINI_PROGRAM_APP_ID=your_miniprogram_appid
MINI_PROGRAM_SECRET=your_miniprogram_secret

# ===== 公众号配置（公众号内 OAuth 网页授权 + PC 二维码 OAuth）=====
OFFICIAL_ACCOUNT_APP_ID=your_official_account_appid
OFFICIAL_ACCOUNT_SECRET=your_official_account_secret

# 公众号网页授权回调地址（公众号后台需配置为授权回调域名）
WECHAT_OAUTH_REDIRECT_URI=https://your-domain.com/api/auth/wechat/callback

# 注意：个人微信开放平台无法创建网站应用
# PC 端扫码登录走的是：
# 1. 小程序扫码确认（PC 显示二维码，小程序扫码确认）
# 2. 公众号 OAuth（微信内打开授权页面）
# 两种方式均通过 UnionID 串联用户

# 日志级别
LOG_LEVEL=info
