{
  "name": "ai-agent-streaming-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "真实可运行的 AI Agent 流式 Markdown + 微前端技术验证 Demo（Vite + Vue3 + TypeScript）",
  "scripts": {
    "dev": "npm run build:widgets && concurrently -n backend,web -c blue,green \"npm run server:real\" \"DEMO_BACKEND_URL=http://localhost:8798 VITE_AGUI_ENDPOINT=/agui VITE_PORT=5181 vite --strictPort\"",
    "build": "vue-tsc --noEmit && node scripts/build-widgets.mjs && vite build",
    "build:widgets": "node scripts/build-widgets.mjs",
    "preview": "vite preview",
    "server": "PORT=8799 node server/mock-sse-server.mjs",
    "server:real": "node --env-file-if-exists=\"$HOME/env_config/demo.env\" server/demo-backend.mjs",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "highlight.js": "^11.9.0",
    "markdown-it": "^14.1.0",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "concurrently": "^9.1.2",
    "typescript": "^5.4.5",
    "vite": "^5.4.0",
    "vitest": "^1.6.0",
    "vue-tsc": "^2.0.16"
  }
}
