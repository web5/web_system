# pnpm 配置（monorepo 根）
# 关闭 safe-delete 批量删除确认：nest build 清理 dist 常超 500 文件阈值，
# 会触发 SAFE_DELETE_BULK_CONFIRM_REQUIRED 导致构建失败（非交互环境无法确认）。
safe-delete=false

# 严格但允许工作区软链接（monorepo 共享包 @web-system/shared）
node-linker=hoisted

# 显式忽略依赖的 build scripts（postinstall）。
# 背景：pnpm 11 把「存在未批准的依赖 build scripts」从警告升级为硬错误
#   ERR_PNPM_IGNORED_BUILDS → exit 1，非交互（CI / 部署目标机）无法执行
#   `pnpm approve-builds` 交互选择，必然失败。
# 本项目 14 个待 build 依赖（esbuild/@swc/core/better-sqlite3/ssh2/…）运行时
# 靠 optionalDependencies 的平台预编译二进制，不需要 postinstall，
# 与 dev 机 pnpm 10 长期「Ignored build scripts（warning）+ exit 0」的行为一致。
ignore-dep-scripts=true
