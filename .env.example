# ============================================================
# web_system 环境配置模板（根 .env.production）
# 复制为 .env.production 后按环境填写。所有变量请保留此注释结构。
# 校验：scripts/check-env.sh
# ============================================================

# ---- 基础 ----
NODE_ENV=production
HOST=0.0.0.0
PUBLIC_URL=https://kedouai.com
CORS_ORIGINS=https://kedouai.com,https://dev.kedouai.com

# ---- 服务端口（prod 3000-3007 / dev 6000-6007）----
GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
USER_SERVICE_PORT=3002
AI_SERVICE_PORT=3003
SYSTEM_SERVICE_PORT=3004
TODO_SERVICE_PORT=3005
MCP_GATEWAY_PORT=6006
CONTENT_HUB_PORT=6007

# ---- 服务间调用地址（注意端口体系：prod 用 3000 系 / dev 用 6000 系）----
AUTH_SERVICE_URL=http://127.0.0.1:3001
USER_SERVICE_URL=http://127.0.0.1:3002
AI_SERVICE_URL=http://127.0.0.1:3003
SYSTEM_SERVICE_URL=http://127.0.0.1:3004
TODO_SERVICE_URL=http://127.0.0.1:3005
UPLOAD_SERVICE_URL=http://127.0.0.1:3010
MCP_GATEWAY_URL=http://127.0.0.1:6006
CONTENT_HUB_SERVICE_URL=http://127.0.0.1:6007

# 网关代理后端服务（同机内网，带 Bearer 鉴权）
FINNEWS_SERVICE_URL=http://127.0.0.1:6000/api/finnews
FINNEWS_SERVICE_KEY=xxx

# ---- 数据库（prod: 腾讯云 172.16.16.10 / dev: 本机 127.0.0.1）----
DB_TYPE=mysql
DB_HOST=172.16.16.10
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=xxx
DB_DATABASE=web_system

# gateway 新版使用 MYSQL_* 变量名（注意不是 USERNAME/DATABASE）
MYSQL_HOST=172.16.16.10
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=xxx
MYSQL_DB=web_system

# deploy-version 元数据连接（deploy-console 用，默认密码 KedouLocal@2026）
DEPLOY_DB_HOST=172.16.16.10
DEPLOY_DB_PORT=3306
DEPLOY_DB_USER=root
DEPLOY_DB_PASSWORD=xxx
DEPLOY_DB_NAME=web_system
# 前端 manifest 的 env 标识：dev / prod（缺失时默认 dev）
DEPLOY_ENV_ID=prod

REDIS_URL=redis://127.0.0.1:6379/0

# ---- JWT ----
JWT_SECRET=xxx
JWT_EXPIRES_IN=7d

# ---- MCP 网关密钥 ----
# legacy 固定密钥（WorkBuddy 旧配置兼容），同时是 mcp-gateway checkAuth 第一步
MCP_CLIENT_KEY=xxx
# 内部服务间调用（mcp-gateway -> user-service /internal/* 用 x-internal-key）
INTERNAL_API_KEY=xxx
# 运营后台密钥（已被 JWT+admin 角色取代，历史兼容可保留）
MCP_ADMIN_KEY=xxx

# ---- 微信小程序 / 公众号 ----
MINI_PROGRAM_APP_ID=xxx
MINI_PROGRAM_SECRET=xxx
# 公众号发布（content-hub / wechat_mp 发布器）
WECHAT_MP_APP_ID=xxx
WECHAT_MP_APP_SECRET=xxx
WECHAT_OAUTH_REDIRECT_URI=https://kedouai.com/api/auth/wechat/callback
# content-hub 兼容别名（OFFICIAL_ACCOUNT 是旧名，与 WECHAT_MP_* 同值）
OFFICIAL_ACCOUNT_APP_ID=xxx
OFFICIAL_ACCOUNT_SECRET=xxx

# ---- SMTP（API Key 验证码邮件）----
SMTP_HOST=smtp.exmail.qq.com
SMTP_PORT=465
SMTP_USER=admin@kedouai.com
SMTP_PASS=xxx
SMTP_FROM=admin@kedouai.com

# ---- LLM（ai-service / content-hub 摘要）----
HY3_API_KEY=xxx
HY3_BASE_URL=https://tokenhub.tencentmaas.com/v1
LLM_API_KEY=xxx
LLM_BASE_URL=https://tokenhub.tencentmaas.com/v1
LLM_MODEL=hy3
IMAGE_GEN_API_KEY=xxx
IMAGE_GEN_API_URL=https://tokenhub.tencentmaas.com/v1
IMAGE_GEN_MODEL=xxx

# ---- 运维 ----
STATIC_ROOT=/data/web_system/servers/gateway/public
LOG_LEVEL=info
