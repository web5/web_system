  <diagram id="flow" name="请求流程图">
    <mxGraphModel dx="1422" dy="757" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="s1" value="1 · 请求页面&#10;GET dev.kedouai.com/ → nginx → gateway:6000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="140" y="30" width="520" height="55" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="2 · 查版本、渲染基座&#10;gateway 查部署库当前版本，向 index.html 注入模块清单（灰度可按用户换版本）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="140" y="115" width="520" height="55" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="3 · 加载基座、自研 loader 与 externals&#10;浏览器执行基座 js + externals（vue / vue-router），loader 解析模块清单" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="140" y="200" width="520" height="55" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="4 · 远程加载模块资源&#10;GET /static/modules/&lt;模块&gt;/&lt;版本&gt;/*.js、*.css → nginx 直接返回，不经过 gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="140" y="285" width="520" height="55" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="5 · 挂载运行&#10;模块注册路由与页面，基座按路由渲染；模块间样式与状态隔离" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="140" y="370" width="520" height="55" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="6 · 业务 API 请求&#10;/api/* → nginx → gateway:6000 鉴权后转发至对应后端服务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="140" y="455" width="520" height="55" as="geometry" />
        </mxCell>
        <mxCell id="fa1" style="endArrow=classic;html=1;" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fa2" style="endArrow=classic;html=1;" edge="1" parent="1" source="s2" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fa3" style="endArrow=classic;html=1;" edge="1" parent="1" source="s3" target="s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fa4" style="endArrow=classic;html=1;" edge="1" parent="1" source="s4" target="s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
