        <mxCell id="externals" value="公共依赖 externals&#10;vue · vue-router · pinia" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="460" y="65" width="145" height="50" as="geometry" />
        </mxCell>
        <mxCell id="nginx" value="nginx (80 / 443)&#10;&#10;/、/api/* → 转发 gateway:6000&#10;/static/modules/* → 模块资源目录（不经网关）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="160" width="500" height="80" as="geometry" />
        </mxCell>
        <mxCell id="staticdir" value="模块资源目录&#10;&#10;/data/web_system/static/&#10;modules/&lt;模块&gt;/&lt;版本&gt;/&#10;未来迁移至 COS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="290" width="190" height="110" as="geometry" />
        </mxCell>
        <mxCell id="gateway" value="gateway :6000&#10;&#10;基座 index.html 服务&#10;注入模块版本清单&#10;/api/* 鉴权与转发&#10;灰度钩子（按用户）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="290" width="190" height="110" as="geometry" />
        </mxCell>
        <mxCell id="backend" value="后端服务（按服务名）&#10;&#10;auth-service / system&#10;ai-service / upload …&#10;pm2 进程管理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="460" y="290" width="190" height="110" as="geometry" />
        </mxCell>
        <mxCell id="deploy" value="deploy-console 发布平台&#10;&#10;前端：模块构建 → 上传版本目录 → 版本表 → 发布指针&#10;后端：git 拉取 + 构建 + pm2 restart（按服务名，不分模块）&#10;prod 仅允许发布 master 分支版本" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="445" width="310" height="95" as="geometry" />
        </mxCell>
