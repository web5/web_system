        <mxCell id="shell" value="微前端基座 Shell&#10;自研 loader" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="135" y="65" width="150" height="50" as="geometry" />
