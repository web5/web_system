        <mxCell id="modules" value="业务模块&#10;portal · admin · mcp-admin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="295" y="65" width="155" height="50" as="geometry" />
