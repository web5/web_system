#!/usr/bin/env bash
# commit-msg — UI 源码 commit 须携带 Proto / Design 凭证（v1.2 · 单一引擎）
# 由 git 通过 core.hooksPath=.githooks 自动调用；由 install-git-hooks.sh 激活。
# 为什么放 commit-msg：pre-commit 拿不到 commit message，无法校验 trailer。
#
# 🔴 2026-11-11（S5）：原实现是 check-commit-msg.sh —— 它自己重写了 is_ui / is_passport /
# exempt_parse / exempt_quality，等于同一套判据两份实现（本地认、CI 不认的摩擦就从这来）。
# 现在它只是 gate.ts 的另一个入口：判据仍然只从 gates.yaml 读，
# 「commit-msg 阶段判哪几道门」也声明在 gates.yaml 的 local_commit_msg 里。
# check-commit-msg.sh 已删除。
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
[ -n "$ROOT" ] || exit 0

# 应急出口：UI_GATE=off 跳过本门（批量机械改动 / 紧急修复）
[ "${UI_GATE:-}" = "off" ] && exit 0

# 传 $2（source）：merge 提交需被识别并豁免——否则合并进来的、早已走过凭证流程的
# UI 文件会被当成「本次改动」稳定误报（2026-09-24 实测）。
exec node "$ROOT/scripts/redline/gate.ts" commit-msg "$1" "${2:-}"
