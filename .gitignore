# Dependencies
node_modules/
.pnp/
.pnp.js

# Build outputs
dist/
build/
*.local
*.tsbuildinfo

# 微前端构建产物（由 build-module.mjs / build-externals.mjs / shell 构建生成，rsync 部署到 gateway public）
servers/gateway/public/shell/
servers/gateway/public/static/

# Vite 加载 TS 配置时生成的临时文件
*.timestamp-*.mjs
*.timestamp-*.mts

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Redis 持久化快照（运行时产物，非源码）
dump.rdb
*.rdb
redis-data/

# Coverage directory
coverage/
*.lcov

# Environment files (all subdirectories — contains sensitive keys/passwords)
**/.env*
# Allow environment example templates (safe to commit)
!**/.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Rush
.rush/
common/temp/

# Test
artifacts/

# Playwright CLI snapshots
.playwright-cli/

apps/mini-app/private.key



# 密钥文件
*.pem
*.key
*.cert

# 本地工具缓存
.workbuddy/

# 运行时上传文件
servers/user-service/uploads/
servers/ai-service/uploads/

# 本地测试脚本（含密钥风险）
servers/ai-service/test-tts.js

