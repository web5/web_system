# Dependencies
# pnpm workspace：禁止 npm lockfile 入仓，混用会破坏依赖一致性（W1 · 5-12，2026-09-25）
package-lock.json
node_modules/
# 同上但**不带斜杠**：上面那条只匹配目录，不匹配 symlink。
# git worktree 里根 node_modules 常建成软链复用主仓依赖（scripts/worktree-link-deps.sh），
# 少了这行它就会以 `?? node_modules` 出现在 git status。实测 git 2.39：per-worktree 的
# $GIT_DIR/info/exclude 不生效，锚定写法 /node_modules 也不匹配 symlink，只有这条管用。
node_modules
.pnp/
.pnp.js

# Build outputs
dist/
build/
*.local
*.tsbuildinfo

# 各服务的历史「投递副本」目录：servers/<svc>/<svc>-dev/<commit>/，每份含自己的 src 快照与
# node_modules。它们不进任何 tsconfig 的 exclude，`nest build` 会当源码一起编译 → 出现
# 「@nestjs/common 被解析成两个版本」这类类型冲突（实测 ai-agent 报 9 处 TS 错，构建直接失败）。
# 不带斜杠的那条覆盖 symlink 形态（同上方 node_modules 的教训）。
servers/*/*-dev/
servers/*/*-dev

# 微前端构建产物（由 build-module.mjs / build-externals.mjs / shell 构建生成，rsync 部署到 gateway public）
servers/gateway/public/shell/
servers/gateway/public/static/

# Vite 加载 TS 配置时生成的临时文件
*.timestamp-*.mjs
*.timestamp-*.mts

# 发布流水线：依赖锁指纹（发布目录 git clean 保护用，避免误删）
.deploy-lock-hash

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Redis 持久化快照（运行时产物，非源码）
dump.rdb
*.rdb
redis-data/

# Coverage directory
coverage/
*.lcov

# Environment files (all subdirectories — contains sensitive keys/passwords)
**/.env*
# Allow environment example templates (safe to commit)
!**/.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Rush
.rush/
common/temp/

# Test
artifacts/

# Playwright CLI snapshots
.playwright-cli/

apps/kedou-ai-minigram/private.key



# 密钥文件
*.pem
*.key
*.cert

# 小程序 CI 产物（预览二维码等，含临时产物不入库）
apps/kedou-ai-minigram/.ci-output/

# 本地工具缓存
.workbuddy/

# 运行时上传文件
servers/user-service/uploads/
servers/ai-service/uploads/

# 本地测试脚本（含密钥风险）
servers/ai-service/test-tts.js

# Agent CLI 本地大模型配置（含 API Key，绝不提交；主目录 ~/.kedou 不在仓库内）
.agent-cli.config.json
servers/ai-service/.agent-cli.config.json


# 集成分支自动发布 watcher 的本地状态文件
.watch-integration.state

# CodeBuddy hook 运行时状态（UI 原型门禁标记，非源码）
.codebuddy/.state/

# 文件监听/传输测试残留
.tmp-wft-*

# git worktree 隔离目录（多会话并行用）
.worktrees/

# WorkBuddy 预览 app 清单（本地生成，appId + 预览目录绝对路径，换机即失效）
.wbapp_*.genie

# 数据库备份（线上真实数据 dump，含业务内容与 external_id，绝不提交）
archive/db-backups/
tests/.env.test
# 本地原型预览发布目录（sites 发布的干净目录，非源码）
.preview/
